{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss.local/spec/runtime-deployment/assembly-lock.schema.json",
  "title": "AssemblyLock target contract",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "identity", "digests", "fingerprint"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "identity": { "$ref": "#/definitions/identity" },
    "digests": { "$ref": "#/definitions/digests" },
    "fingerprint": {
      "description": "sha256: + lowercase SHA-256 of ASCII stage tag rss-assembly-lock-v1, one NUL byte, then RFC 8785 JCS UTF-8 bytes of unsigned {schemaVersion,identity,digests}; this result field is excluded from its own preimage.",
      "allOf": [{ "$ref": "#/definitions/sha256" }]
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["name", "profile"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "profile": { "type": "string", "enum": ["production", "demo", "test"] } }
    },
    "digests": {
      "type": "object", "additionalProperties": false, "required": ["manifest", "generated", "contracts"],
      "properties": { "manifest": { "$ref": "#/definitions/sha256" }, "generated": { "$ref": "#/definitions/sha256" }, "contracts": { "$ref": "#/definitions/sha256" } }
    }
  }
}
