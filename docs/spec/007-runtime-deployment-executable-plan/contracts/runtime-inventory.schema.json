{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss.local/spec/runtime-deployment/runtime-inventory.schema.json",
  "title": "RuntimeInventory target design contract",
  "description": "Design input for #1806; not the production HTTP wire source.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assemblyFingerprint", "runtimePlanFingerprint", "deploymentFingerprint", "buildIdentity", "domains", "listeners", "providerPosture", "placements"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "assemblyFingerprint": { "$ref": "#/definitions/sha256" },
    "runtimePlanFingerprint": { "$ref": "#/definitions/sha256" },
    "deploymentFingerprint": { "$ref": "#/definitions/sha256" },
    "buildIdentity": { "$ref": "#/definitions/buildIdentity" },
    "domains": { "description": "Preserve assembly declaration order; identities remain unique.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/assemblyDomain" } },
    "listeners": { "description": "Set-like; serialize in listener id order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/listener" } },
    "providerPosture": { "description": "Set-like; serialize in provider id order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/providerPosture" } },
    "placements": { "description": "Set-like; serialize by domain then workload.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/placement" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assemblyDomain": { "type": "string", "enum": ["identity", "settings", "audit", "contractreg", "syshealth"] },
    "listenerKind": { "type": "string", "enum": ["primary", "internal", "health", "admin"] },
    "authScheme": { "type": "string", "enum": ["noAuth", "rssAccessToken", "federatedAccessToken", "mtls", "serviceToken"] },
    "buildIdentity": { "type": "object", "additionalProperties": false, "required": ["sourceSha", "imageDigest"], "properties": { "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "imageDigest": { "$ref": "#/definitions/sha256" } } },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["scheme", "host", "port"],
      "properties": { "scheme": { "type": "string", "enum": ["http", "https"] }, "host": { "type": "string", "maxLength": 253, "anyOf": [{ "format": "hostname" }, { "format": "ipv4" }, { "format": "ipv6" }] }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "listener": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "endpoint", "authScheme"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "$ref": "#/definitions/listenerKind" }, "endpoint": { "$ref": "#/definitions/endpoint" }, "authScheme": { "$ref": "#/definitions/authScheme" } } },
    "providerPosture": { "type": "object", "additionalProperties": false, "required": ["id", "state"], "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["ready", "degraded", "unavailable"] } } },
    "placement": { "type": "object", "additionalProperties": false, "required": ["domain", "workload"], "properties": { "domain": { "$ref": "#/definitions/assemblyDomain" }, "workload": { "type": "string", "minLength": 1 } } }
  }
}
