{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss.local/spec/runtime-deployment/runtime-plan.schema.json",
  "title": "RuntimePlan target contract",
  "type": "object", "additionalProperties": false,
  "required": ["assemblyFingerprint", "domainPlans", "listenerPlans", "placementPlans", "providerPlans", "runtimePlanFingerprint", "schemaVersion"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "assemblyFingerprint": { "$ref": "#/definitions/sha256" },
    "runtimePlanFingerprint": {
      "description": "sha256: + lowercase SHA-256 of ASCII stage tag rss-runtime-plan-v1, one NUL byte, then RFC 8785 JCS UTF-8 bytes of unsigned {schemaVersion,assemblyFingerprint,providerPlans,listenerPlans,domainPlans,placementPlans}; every stable plan fact is covered and this result field is excluded from its own preimage.",
      "allOf": [{ "$ref": "#/definitions/sha256" }]
    },
    "providerPlans": { "description": "Non-empty set-like declarations; serialize by ascending provider id. The strict reader rejects keyed duplicates and any other order.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/providerPlan" } },
    "listenerPlans": { "description": "Non-empty set-like declarations; serialize by ascending listener id. The strict reader rejects keyed duplicates and any other order.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/listenerPlan" } },
    "domainPlans": { "description": "Non-empty declaration sequence; preserve canonical manifest domain order and reject duplicate ids.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/domainPlan" } },
    "placementPlans": { "description": "Non-empty set-like declarations; exactly one placement per domain, serialized by wire domain then workload.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/placementPlan" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assemblyDomain": { "type": "string", "enum": ["identity", "settings", "audit", "contractreg", "syshealth"] },
    "listenerKind": { "type": "string", "enum": ["primary", "internal", "health", "admin"] },
    "authScheme": { "type": "string", "enum": ["noAuth", "rssAccessToken", "federatedAccessToken", "mtls", "serviceToken"] },
    "lifecycleChannel": { "type": "string", "enum": ["probes", "resources", "workers"] },
    "providerPlan": {
      "type": "object", "additionalProperties": false, "required": ["constructor", "id", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "constructor": {
          "type": "string",
          "enum": [
            "postgres::PgRevocationStore",
            "ratelimit::GovernorLimiter",
            "amqp::AmqpPublisher",
            "amqp::AmqpSubscriber",
            "redis::RedisLockStore",
            "redis::RedisCasStore",
            "postgres::PgCasStore",
            "postgres::PgAuthAuditSink",
            "postgres::PgServiceTokenReplayStore",
            "postgres::PgDlxLifecycleRepository",
            "vault::VaultSigner",
            "vault::VaultKeyProvider",
            "oidc::OidcProvider",
            "s3::S3Store",
            "s3::VerifiedS3DlxArchiveStore"
          ]
        },
        "outputs": { "description": "Set-like; serialize in probes, resources, workers order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/lifecycleChannel" } }
      }
    },
    "listenerPlan": {
      "type": "object", "additionalProperties": false, "required": ["auth", "domains", "id", "kind"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "kind": { "$ref": "#/definitions/listenerKind" }, "auth": { "$ref": "#/definitions/authScheme" }, "domains": { "description": "Preserve declared route-mount order; each value references domainPlans.id.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/assemblyDomain" } } },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["primary", "admin"] } }, "required": ["kind"] }, "then": { "properties": { "auth": { "enum": ["rssAccessToken", "federatedAccessToken"] } } } },
        { "if": { "properties": { "kind": { "const": "health" } }, "required": ["kind"] }, "then": { "properties": { "auth": { "const": "noAuth" } } } },
        { "if": { "properties": { "kind": { "const": "internal" } }, "required": ["kind"] }, "then": { "properties": { "auth": { "enum": ["mtls", "serviceToken"] } } } }
      ]
    },
    "domainPlan": { "type": "object", "additionalProperties": false, "required": ["id", "lifecycle"], "properties": { "id": { "$ref": "#/definitions/assemblyDomain" }, "lifecycle": { "description": "Closed v1 transition sequence; order is semantic.", "type": "array", "const": ["construct", "ready", "shutdown"] } } },
    "placementPlan": { "type": "object", "additionalProperties": false, "required": ["domain", "workload"], "properties": { "domain": { "$ref": "#/definitions/assemblyDomain" }, "workload": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } } }
  }
}
