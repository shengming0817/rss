{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss.local/spec/runtime-deployment/runtime-plan.schema.json",
  "title": "RuntimePlan target contract",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assemblyFingerprint", "runtimePlanFingerprint", "providerPlans", "listenerPlans", "domainPlans", "placementPlans"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "assemblyFingerprint": { "$ref": "#/definitions/sha256" },
    "runtimePlanFingerprint": {
      "description": "sha256: + lowercase SHA-256 of ASCII stage tag rss-runtime-plan-v1, one NUL byte, then RFC 8785 JCS UTF-8 bytes of unsigned {schemaVersion,assemblyFingerprint,providerPlans,listenerPlans,domainPlans,placementPlans}; every stable plan fact is covered and this result field is excluded from its own preimage.",
      "allOf": [{ "$ref": "#/definitions/sha256" }]
    },
    "providerPlans": { "description": "Set-like; serialize in provider id order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/providerPlan" } },
    "listenerPlans": { "description": "Set-like; serialize in listener id order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/listenerPlan" } },
    "domainPlans": { "description": "Preserve manifest declaration order; identities remain unique.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/domainPlan" } },
    "placementPlans": { "description": "Set-like; serialize by domain then workload.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/placementPlan" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assemblyDomain": { "type": "string", "enum": ["identity", "settings", "audit", "contractreg", "syshealth"] },
    "listenerKind": { "type": "string", "enum": ["primary", "internal", "health", "admin"] },
    "authScheme": { "type": "string", "enum": ["noAuth", "jwt", "mtls", "serviceToken", "jwtFromAssembly"] },
    "lifecycleChannel": { "type": "string", "enum": ["probes", "resources", "workers"] },
    "providerPlan": {
      "type": "object", "additionalProperties": false, "required": ["id", "constructor", "outputs"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "constructor": { "type": "string", "minLength": 1 }, "outputs": { "description": "Set-like; stable LifecycleChannel order.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/lifecycleChannel" } } }
    },
    "listenerPlan": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "auth", "domains"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "$ref": "#/definitions/listenerKind" }, "auth": { "$ref": "#/definitions/authScheme" }, "domains": { "description": "Preserve declared route-mount order; each value references domainPlans.id.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/assemblyDomain" } } },
      "allOf": [{ "if": { "properties": { "kind": { "enum": ["internal", "admin"] } }, "required": ["kind"] }, "then": { "properties": { "auth": { "not": { "const": "noAuth" } } } } }]
    },
    "domainPlan": { "type": "object", "additionalProperties": false, "required": ["id", "lifecycle"], "properties": { "id": { "$ref": "#/definitions/assemblyDomain" }, "lifecycle": { "description": "Preserve declared transition order.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "placementPlan": { "type": "object", "additionalProperties": false, "required": ["domain", "workload"], "properties": { "domain": { "$ref": "#/definitions/assemblyDomain" }, "workload": { "type": "string", "minLength": 1 } } }
  }
}
