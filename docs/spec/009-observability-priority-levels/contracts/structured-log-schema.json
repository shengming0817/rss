{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.local/spec/009/structured-log-schema.json",
  "title": "RSS runtime structured log envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "level",
    "target",
    "message",
    "trace_id",
    "span_id",
    "request_id",
    "correlation",
    "resource",
    "attributes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "level": { "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"] },
    "target": { "type": "string", "minLength": 1 },
    "message": { "type": ["string", "null"] },
    "trace_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{16}$"
    },
    "request_id": { "type": ["string", "null"] },
    "correlation": { "type": ["string", "null"] },
    "resource": {
      "type": "object",
      "required": [
        "service.name",
        "rss.assembly.fingerprint",
        "rss.runtime_plan.fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "service.name": { "type": "string", "minLength": 1 },
        "rss.assembly.fingerprint": { "type": "string", "minLength": 1 },
        "rss.runtime_plan.fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
