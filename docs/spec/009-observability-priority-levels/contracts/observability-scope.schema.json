{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.local/spec/009/observability-scope.schema.json",
  "title": "Spec 009 tracker scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["epic", "root", "blocked"],
  "properties": {
    "epic": { "const": 2034 },
    "root": { "const": 2035 },
    "blocked": {
      "type": "array",
      "prefixItems": [
        { "const": 2037 },
        { "const": 2038 },
        { "const": 2036 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
