{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityDeviceIngressReceiptedEventProposal",
  "description": "Draft OutboxFact application-receipt payload proposal. Its own stable event ID is carried only by the envelope.",
  "oneOf": [
    { "$ref": "#/definitions/IdentityDeviceIngressCommittedPayload" },
    { "$ref": "#/definitions/IdentityDeviceIngressDuplicatePayload" },
    { "$ref": "#/definitions/IdentityDeviceIngressStalePayload" },
    { "$ref": "#/definitions/IdentityDeviceIngressRejectedPayload" }
  ],
  "definitions": {
    "IdentityDeviceIngressCommittedPayload": {
      "title": "IdentityDeviceIngressCommittedPayload",
      "type": "object",
      "required": ["ingressEnvelopeId", "deviceId", "outcome", "reason", "committedAt"],
      "properties": {
        "ingressEnvelopeId": { "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.", "type": "string", "minLength": 1, "maxLength": 256 },
        "deviceId": { "type": "string", "format": "uuid" },
        "outcome": { "type": "string", "enum": ["committed"] },
        "reason": { "type": "string", "enum": ["None"] },
        "committedAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    },
    "IdentityDeviceIngressDuplicatePayload": {
      "title": "IdentityDeviceIngressDuplicatePayload",
      "type": "object",
      "required": ["ingressEnvelopeId", "deviceId", "outcome", "reason", "committedAt"],
      "properties": {
        "ingressEnvelopeId": { "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.", "type": "string", "minLength": 1, "maxLength": 256 },
        "deviceId": { "type": "string", "format": "uuid" },
        "outcome": { "type": "string", "enum": ["duplicate"] },
        "reason": { "type": "string", "enum": ["AlreadyCommitted"] },
        "committedAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    },
    "IdentityDeviceIngressStalePayload": {
      "title": "IdentityDeviceIngressStalePayload",
      "type": "object",
      "required": ["ingressEnvelopeId", "deviceId", "outcome", "reason", "committedAt"],
      "properties": {
        "ingressEnvelopeId": { "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.", "type": "string", "minLength": 1, "maxLength": 256 },
        "deviceId": { "type": "string", "format": "uuid" },
        "outcome": { "type": "string", "enum": ["stale"] },
        "reason": { "type": "string", "enum": ["GenerationStale", "FenceEpochStale", "DeviceSequenceStale"] },
        "committedAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    },
    "IdentityDeviceIngressRejectedPayload": {
      "title": "IdentityDeviceIngressRejectedPayload",
      "type": "object",
      "required": ["ingressEnvelopeId", "deviceId", "outcome", "reason", "committedAt"],
      "properties": {
        "ingressEnvelopeId": { "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.", "type": "string", "minLength": 1, "maxLength": 256 },
        "deviceId": { "type": "string", "format": "uuid" },
        "outcome": { "type": "string", "enum": ["rejected"] },
        "reason": { "type": "string", "enum": ["NotAccepted", "SchemaRejected", "ProtocolViolation"] },
        "committedAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    }
  }
}
