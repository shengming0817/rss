{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsOnlyConfig",
  "description": "The complete version-two production document. Every field is mandatory.",
  "type": "object",
  "required": [
    "dlx",
    "drain",
    "eventing",
    "federated",
    "listeners",
    "postgres",
    "profile",
    "readiness",
    "redis",
    "s3",
    "schemaVersion",
    "tenantAuthority",
    "topology",
    "vault"
  ],
  "properties": {
    "dlx": {
      "$ref": "#/definitions/DlxConfig"
    },
    "drain": {
      "$ref": "#/definitions/DrainConfig"
    },
    "eventing": {
      "$ref": "#/definitions/EventingConfig"
    },
    "federated": {
      "$ref": "#/definitions/FederatedConfig"
    },
    "listeners": {
      "$ref": "#/definitions/ListenersConfig"
    },
    "postgres": {
      "$ref": "#/definitions/PostgresConfig"
    },
    "profile": {
      "$ref": "#/definitions/ProductionProfile"
    },
    "readiness": {
      "$ref": "#/definitions/ReadinessConfig"
    },
    "redis": {
      "$ref": "#/definitions/RedisConfig"
    },
    "s3": {
      "$ref": "#/definitions/S3Config"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "tenantAuthority": {
      "$ref": "#/definitions/TenantAuthorityConfig"
    },
    "topology": {
      "$ref": "#/definitions/DurableTopology"
    },
    "vault": {
      "$ref": "#/definitions/VaultConfig"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DlxConfig": {
      "type": "object",
      "required": [
        "archiveKeyName",
        "hotKeyName",
        "readinessSeconds"
      ],
      "properties": {
        "archiveKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "hotKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "DrainConfig": {
      "type": "object",
      "required": [
        "totalSeconds"
      ],
      "properties": {
        "totalSeconds": {
          "type": "integer",
          "const": 60
        }
      },
      "additionalProperties": false
    },
    "DurableTopology": {
      "type": "string",
      "enum": [
        "durable-isolated"
      ]
    },
    "EventingConfig": {
      "type": "object",
      "required": [
        "amqpCaCertPemPath",
        "publisherConfirmTimeoutMs"
      ],
      "properties": {
        "amqpCaCertPemPath": {
          "type": "string"
        },
        "publisherConfirmTimeoutMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 60000.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "FederatedConfig": {
      "type": "object",
      "required": [
        "audience",
        "issuer",
        "jwksPath",
        "refreshSeconds",
        "trustedKinds"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "jwksPath": {
          "type": "string",
          "minLength": 1
        },
        "refreshSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        },
        "trustedKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrustedKind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ListenerEndpoint": {
      "type": "object",
      "required": [
        "bind"
      ],
      "properties": {
        "bind": {
          "$ref": "#/definitions/PlaintextLoopbackAddress"
        }
      },
      "additionalProperties": false
    },
    "ListenersConfig": {
      "type": "object",
      "required": [
        "admin",
        "health",
        "primary",
        "requestBudgetMs"
      ],
      "properties": {
        "admin": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "health": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "primary": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "requestBudgetMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 20000.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "PgDlxArchiverRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 20.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgDlxPurgerRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 20.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgDlxVerifierRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 20.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgReaderRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgWriterRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PlaintextLoopbackAddress": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:127\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "PostgresConfig": {
      "type": "object",
      "required": [
        "database",
        "dlxArchiver",
        "dlxPurger",
        "dlxVerifier",
        "host",
        "port",
        "reader",
        "readinessSeconds",
        "sslMode",
        "sslRootCertPath",
        "writer"
      ],
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "dlxArchiver": {
          "$ref": "#/definitions/PgDlxArchiverRoleConfig"
        },
        "dlxPurger": {
          "$ref": "#/definitions/PgDlxPurgerRoleConfig"
        },
        "dlxVerifier": {
          "$ref": "#/definitions/PgDlxVerifierRoleConfig"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 1.0
        },
        "reader": {
          "$ref": "#/definitions/PgReaderRoleConfig"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        },
        "sslMode": {
          "type": "string",
          "const": "verifyFull"
        },
        "sslRootCertPath": {
          "type": "string"
        },
        "writer": {
          "$ref": "#/definitions/PgWriterRoleConfig"
        }
      },
      "additionalProperties": false
    },
    "ProductionProfile": {
      "type": "string",
      "enum": [
        "production"
      ]
    },
    "ReadinessConfig": {
      "type": "object",
      "required": [
        "startupTimeoutSeconds"
      ],
      "properties": {
        "startupTimeoutSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "RedisConfig": {
      "type": "object",
      "required": [
        "caCertPemPath",
        "readinessSeconds"
      ],
      "properties": {
        "caCertPemPath": {
          "type": "string"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "S3Config": {
      "type": "object",
      "required": [
        "archiveBucket",
        "caCertPemPath",
        "endpoint",
        "forcePathStyle",
        "readinessSeconds",
        "region"
      ],
      "properties": {
        "archiveBucket": {
          "type": "string",
          "maxLength": 63,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "caCertPemPath": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://.+$"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "TenantAuthorityConfig": {
      "type": "object",
      "required": [
        "clockSkewSeconds",
        "ttlSeconds"
      ],
      "properties": {
        "clockSkewSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 0.0
        },
        "ttlSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 86400.0,
          "minimum": 3600.0
        }
      },
      "additionalProperties": false
    },
    "TrustedKind": {
      "description": "Principal kinds accepted from the one federated verifier profile.",
      "type": "string",
      "enum": [
        "user",
        "device",
        "admin",
        "superAdmin"
      ]
    },
    "VaultConfig": {
      "type": "object",
      "required": [
        "addr",
        "caCertPemPath",
        "readinessSeconds",
        "settingsKeyName",
        "tenantStoreAllowlist",
        "transitMount"
      ],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "caCertPemPath": {
          "type": "string"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "settingsKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "tenantStoreAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VaultStoreBindingConfig"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitMount": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "VaultStoreBindingConfig": {
      "type": "object",
      "required": [
        "kvPathPrefix",
        "mount",
        "storeId",
        "tenantId"
      ],
      "properties": {
        "kvPathPrefix": {
          "type": "string",
          "not": {
            "type": "string",
            "pattern": "(?:^|/)(?:\\.|\\.\\.)(?:/|$)"
          },
          "pattern": "^(?:[^/]+(?:/[^/]+)*)?$"
        },
        "mount": {
          "type": "string",
          "not": {
            "type": "string",
            "pattern": "(?:^|/)(?:\\.|\\.\\.)(?:/|$)"
          },
          "minLength": 1,
          "pattern": "^[^/]+(?:/[^/]+)*$"
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  }
}
