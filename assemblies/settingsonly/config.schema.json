{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsOnlyConfig",
  "description": "The complete version-one document. All fields are mandatory unless represented as `Option`.",
  "type": "object",
  "required": [
    "federated",
    "listeners",
    "postgres",
    "schemaVersion",
    "vault"
  ],
  "properties": {
    "federated": {
      "$ref": "#/definitions/FederatedConfig"
    },
    "listeners": {
      "$ref": "#/definitions/ListenersConfig"
    },
    "postgres": {
      "$ref": "#/definitions/PostgresConfig"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "vault": {
      "$ref": "#/definitions/VaultConfig"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "FederatedConfig": {
      "type": "object",
      "required": [
        "audience",
        "issuer",
        "jwksPath",
        "refreshSeconds",
        "trustedKinds"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "jwksPath": {
          "type": "string",
          "minLength": 1
        },
        "refreshSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        },
        "trustedKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrustedKind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ListenerEndpoint": {
      "type": "object",
      "required": [
        "bind"
      ],
      "properties": {
        "bind": {
          "$ref": "#/definitions/PlaintextLoopbackAddress"
        }
      },
      "additionalProperties": false
    },
    "ListenersConfig": {
      "type": "object",
      "required": [
        "admin",
        "health",
        "primary",
        "requestBudgetMs"
      ],
      "properties": {
        "admin": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "health": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "primary": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "requestBudgetMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "PgReaderRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgSslMode": {
      "description": "Closed PostgreSQL TLS policy.",
      "type": "string",
      "enum": [
        "disable",
        "prefer",
        "require",
        "verifyCa",
        "verifyFull"
      ]
    },
    "PgWriterRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PlaintextLoopbackAddress": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:127\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "PostgresConfig": {
      "type": "object",
      "required": [
        "database",
        "host",
        "port",
        "reader",
        "readinessSeconds",
        "sslMode",
        "writer"
      ],
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 1.0
        },
        "reader": {
          "$ref": "#/definitions/PgReaderRoleConfig"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        },
        "sslMode": {
          "$ref": "#/definitions/PgSslMode"
        },
        "sslRootCertPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "writer": {
          "$ref": "#/definitions/PgWriterRoleConfig"
        }
      },
      "additionalProperties": false
    },
    "TrustedKind": {
      "description": "Principal kinds accepted from the one federated verifier profile.",
      "type": "string",
      "enum": [
        "user",
        "device",
        "admin",
        "superAdmin"
      ]
    },
    "VaultConfig": {
      "type": "object",
      "required": [
        "addr",
        "readinessSeconds",
        "settingsKeyName",
        "tenantStoreAllowlist",
        "transitMount"
      ],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "caCertPemPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "settingsKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "tenantStoreAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VaultStoreBindingConfig"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitMount": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "VaultStoreBindingConfig": {
      "type": "object",
      "required": [
        "kvPathPrefix",
        "mount",
        "storeId",
        "tenantId"
      ],
      "properties": {
        "kvPathPrefix": {
          "type": "string",
          "not": {
            "type": "string",
            "pattern": "(?:^|/)(?:\\.|\\.\\.)(?:/|$)"
          },
          "pattern": "^(?:[^/]+(?:/[^/]+)*)?$"
        },
        "mount": {
          "type": "string",
          "not": {
            "type": "string",
            "pattern": "(?:^|/)(?:\\.|\\.\\.)(?:/|$)"
          },
          "minLength": 1,
          "pattern": "^[^/]+(?:/[^/]+)*$"
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  }
}
