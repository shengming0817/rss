{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceIdentityConfig",
  "type": "object",
  "required": [
    "csr",
    "identity",
    "listeners",
    "mqtt",
    "oidc",
    "postgres",
    "redis",
    "schemaVersion",
    "vault",
    "workers"
  ],
  "properties": {
    "csr": {
      "$ref": "#/definitions/Csr"
    },
    "identity": {
      "$ref": "#/definitions/Identity"
    },
    "listeners": {
      "$ref": "#/definitions/Listeners"
    },
    "mqtt": {
      "$ref": "#/definitions/Mqtt"
    },
    "oidc": {
      "$ref": "#/definitions/Oidc"
    },
    "postgres": {
      "$ref": "#/definitions/Postgres"
    },
    "redis": {
      "$ref": "#/definitions/Redis"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "vault": {
      "$ref": "#/definitions/Vault"
    },
    "workers": {
      "$ref": "#/definitions/Workers"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Csr": {
      "type": "object",
      "required": [
        "localSpiffeId",
        "maxPemBytes",
        "remoteSpiffeAllowSet",
        "url"
      ],
      "properties": {
        "localSpiffeId": {
          "type": "string",
          "pattern": "^spiffe://"
        },
        "maxPemBytes": {
          "type": "integer",
          "format": "uint",
          "maximum": 65536.0,
          "minimum": 65536.0
        },
        "remoteSpiffeAllowSet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://.*?/internal/v1/device-csr:resolve$"
        }
      },
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "required": [
        "holderId",
        "tenant"
      ],
      "properties": {
        "holderId": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Listeners": {
      "type": "object",
      "required": [
        "health",
        "internal",
        "internalClientSpiffeAllowSet",
        "primary",
        "requestBudgetMs",
        "trustedProxyCidrs"
      ],
      "properties": {
        "health": {
          "$ref": "#/definitions/LoopbackSocketAddress"
        },
        "internal": {
          "$ref": "#/definitions/LoopbackSocketAddress"
        },
        "internalClientSpiffeAllowSet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "primary": {
          "$ref": "#/definitions/LoopbackSocketAddress"
        },
        "requestBudgetMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        },
        "trustedProxyCidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "LoopbackSocketAddress": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:127\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "Mqtt": {
      "type": "object",
      "required": [
        "brokerAssertionPublicKeyHex",
        "caPemPath",
        "scopes",
        "sessionExpirySeconds",
        "url"
      ],
      "properties": {
        "brokerAssertionPublicKeyHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "caPemPath": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MqttScope"
          },
          "minItems": 1
        },
        "sessionExpirySeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 86400.0,
          "minimum": 1.0
        },
        "url": {
          "type": "string",
          "pattern": "^mqtts://"
        }
      },
      "additionalProperties": false
    },
    "MqttScope": {
      "type": "object",
      "required": [
        "device",
        "generation",
        "tenant"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1.0
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Oidc": {
      "type": "object",
      "required": [
        "audience",
        "issuer",
        "jwksPath",
        "refreshSeconds"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "pattern": "^https://"
        },
        "jwksPath": {
          "type": "string"
        },
        "refreshSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "Postgres": {
      "type": "object",
      "required": [
        "caPemPath",
        "database",
        "host",
        "port",
        "verifyMode"
      ],
      "properties": {
        "caPemPath": {
          "type": "string"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 1.0
        },
        "verifyMode": {
          "$ref": "#/definitions/VerifyFull"
        }
      },
      "additionalProperties": false
    },
    "Redis": {
      "type": "object",
      "required": [
        "caPemPath",
        "url"
      ],
      "properties": {
        "caPemPath": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^rediss://"
        }
      },
      "additionalProperties": false
    },
    "Vault": {
      "type": "object",
      "required": [
        "caPemPath",
        "mount",
        "role",
        "url"
      ],
      "properties": {
        "caPemPath": {
          "type": "string"
        },
        "mount": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    },
    "VerifyFull": {
      "type": "string",
      "enum": [
        "verify-full"
      ]
    },
    "Workers": {
      "type": "object",
      "required": [
        "commandRelayMs",
        "receiptRelayMs",
        "reconcileMs",
        "shutdownMs"
      ],
      "properties": {
        "commandRelayMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        },
        "receiptRelayMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        },
        "reconcileMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        },
        "shutdownMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    }
  }
}
