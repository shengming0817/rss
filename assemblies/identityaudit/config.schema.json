{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityAuditConfig",
  "type": "object",
  "required": [
    "eventing",
    "identity",
    "listeners",
    "oidc",
    "postgres",
    "schemaVersion",
    "vault"
  ],
  "properties": {
    "eventing": {
      "$ref": "#/definitions/EventingConfig"
    },
    "identity": {
      "$ref": "#/definitions/IdentityConfig"
    },
    "listeners": {
      "$ref": "#/definitions/ListenersConfig"
    },
    "oidc": {
      "$ref": "#/definitions/OidcConfig"
    },
    "postgres": {
      "$ref": "#/definitions/PostgresConfig"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "vault": {
      "$ref": "#/definitions/VaultConfig"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AuditChainKeyEnvironment": {
      "type": "string",
      "enum": [
        "RSS_AUDIT_CHAIN_KEY_B64URL"
      ]
    },
    "AuditChainKeyReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/AuditChainKeyEnvironment"
        }
      },
      "additionalProperties": false
    },
    "EnvironmentReferenceKind": {
      "type": "string",
      "enum": [
        "environmentRef"
      ]
    },
    "EventingConfig": {
      "type": "object",
      "required": [
        "auditChainKey",
        "auditChainKeyId",
        "identityAmqpUrl",
        "redisUrl",
        "tenantAuthorityClockSkewSeconds",
        "tenantAuthorityKey",
        "tenantAuthorityTtlSeconds"
      ],
      "properties": {
        "auditChainKey": {
          "$ref": "#/definitions/AuditChainKeyReference"
        },
        "auditChainKeyId": {
          "type": "integer",
          "const": 1
        },
        "identityAmqpUrl": {
          "$ref": "#/definitions/IdentityAmqpUrlReference"
        },
        "redisUrl": {
          "$ref": "#/definitions/RedisUrlReference"
        },
        "tenantAuthorityClockSkewSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 0.0
        },
        "tenantAuthorityKey": {
          "$ref": "#/definitions/TenantAuthorityKeyReference"
        },
        "tenantAuthorityTtlSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 86400.0,
          "minimum": 3600.0
        }
      },
      "additionalProperties": false
    },
    "IdentityAmqpUrlEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITY_AMQP_URL"
      ]
    },
    "IdentityAmqpUrlReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/IdentityAmqpUrlEnvironment"
        }
      },
      "additionalProperties": false
    },
    "IdentityConfig": {
      "type": "object",
      "required": [
        "accessTtlSeconds",
        "audience",
        "authGrantTtlSeconds",
        "issuer",
        "keyId",
        "passwordBlocklistPath",
        "refreshTtlSeconds"
      ],
      "properties": {
        "accessTtlSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 86400.0,
          "minimum": 60.0
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "authGrantTtlSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 2592000.0,
          "minimum": 60.0
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "passwordBlocklistPath": {
          "type": "string",
          "minLength": 1
        },
        "refreshTtlSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 2592000.0,
          "minimum": 60.0
        }
      },
      "additionalProperties": false
    },
    "ListenerEndpoint": {
      "type": "object",
      "required": [
        "bind"
      ],
      "properties": {
        "bind": {
          "$ref": "#/definitions/PlaintextLoopbackAddress"
        }
      },
      "additionalProperties": false
    },
    "ListenersConfig": {
      "type": "object",
      "required": [
        "admin",
        "health",
        "primary",
        "requestBudgetMs"
      ],
      "properties": {
        "admin": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "health": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "primary": {
          "$ref": "#/definitions/ListenerEndpoint"
        },
        "requestBudgetMs": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300000.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "OidcConfig": {
      "type": "object",
      "required": [
        "audience",
        "issuer",
        "jwksPath",
        "refreshSeconds"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "jwksPath": {
          "type": "string",
          "minLength": 1
        },
        "refreshSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 300.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "PgAuditAdminPasswordEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_PG_AUDIT_ADMIN_PASSWORD"
      ]
    },
    "PgAuditAdminPasswordReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/PgAuditAdminPasswordEnvironment"
        }
      },
      "additionalProperties": false
    },
    "PgAuditAdminRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "password",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "password": {
          "$ref": "#/definitions/PgAuditAdminPasswordReference"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgConnectionConfig": {
      "type": "object",
      "required": [
        "database",
        "host",
        "port",
        "sslMode"
      ],
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 1.0
        },
        "sslMode": {
          "$ref": "#/definitions/PgSslMode"
        },
        "sslRootCertPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "PgMigratorPasswordEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_PG_MIGRATOR_PASSWORD"
      ]
    },
    "PgMigratorPasswordReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/PgMigratorPasswordEnvironment"
        }
      },
      "additionalProperties": false
    },
    "PgMigratorRoleConfig": {
      "type": "object",
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "password": {
          "$ref": "#/definitions/PgMigratorPasswordReference"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgReaderPasswordEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_PG_READER_PASSWORD"
      ]
    },
    "PgReaderPasswordReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/PgReaderPasswordEnvironment"
        }
      },
      "additionalProperties": false
    },
    "PgReaderRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "password",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "password": {
          "$ref": "#/definitions/PgReaderPasswordReference"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PgSslMode": {
      "type": "string",
      "enum": [
        "disable",
        "verifyFull"
      ]
    },
    "PgWriterPasswordEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_PG_WRITER_PASSWORD"
      ]
    },
    "PgWriterPasswordReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/PgWriterPasswordEnvironment"
        }
      },
      "additionalProperties": false
    },
    "PgWriterRoleConfig": {
      "type": "object",
      "required": [
        "maxConnections",
        "password",
        "username"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "format": "uint32",
          "maximum": 100.0,
          "minimum": 1.0
        },
        "password": {
          "$ref": "#/definitions/PgWriterPasswordReference"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "PlaintextLoopbackAddress": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:127\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "PostgresConfig": {
      "type": "object",
      "required": [
        "auditAdmin",
        "connection",
        "migrator",
        "reader",
        "writer"
      ],
      "properties": {
        "auditAdmin": {
          "$ref": "#/definitions/PgAuditAdminRoleConfig"
        },
        "connection": {
          "$ref": "#/definitions/PgConnectionConfig"
        },
        "migrator": {
          "$ref": "#/definitions/PgMigratorRoleConfig"
        },
        "reader": {
          "$ref": "#/definitions/PgReaderRoleConfig"
        },
        "writer": {
          "$ref": "#/definitions/PgWriterRoleConfig"
        }
      },
      "additionalProperties": false
    },
    "RedisUrlEnvironment": {
      "type": "string",
      "enum": [
        "RSS_REDIS_URL"
      ]
    },
    "RedisUrlReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/RedisUrlEnvironment"
        }
      },
      "additionalProperties": false
    },
    "TenantAuthorityKeyEnvironment": {
      "type": "string",
      "enum": [
        "RSS_TENANT_AUTHORITY_HMAC_KEY_B64URL"
      ]
    },
    "TenantAuthorityKeyReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/TenantAuthorityKeyEnvironment"
        }
      },
      "additionalProperties": false
    },
    "VaultConfig": {
      "type": "object",
      "required": [
        "addr",
        "caCertPemPath",
        "dlxPayloadKeyName",
        "dlxToken",
        "readinessSeconds",
        "signerToken",
        "signingKeyName",
        "transitMount"
      ],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "caCertPemPath": {
          "type": "string",
          "minLength": 1
        },
        "dlxPayloadKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "dlxToken": {
          "$ref": "#/definitions/VaultDlxTokenReference"
        },
        "readinessSeconds": {
          "type": "integer",
          "format": "uint64",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "signerToken": {
          "$ref": "#/definitions/VaultSignerTokenReference"
        },
        "signingKeyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "transitMount": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        }
      },
      "additionalProperties": false
    },
    "VaultDlxTokenEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_VAULT_DLX_TOKEN"
      ]
    },
    "VaultDlxTokenReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/VaultDlxTokenEnvironment"
        }
      },
      "additionalProperties": false
    },
    "VaultSignerTokenEnvironment": {
      "type": "string",
      "enum": [
        "RSS_IDENTITYAUDIT_VAULT_SIGNER_TOKEN"
      ]
    },
    "VaultSignerTokenReference": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvironmentReferenceKind"
        },
        "name": {
          "$ref": "#/definitions/VaultSignerTokenEnvironment"
        }
      },
      "additionalProperties": false
    }
  }
}
