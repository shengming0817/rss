{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityRefreshResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "title": "IdentityRefreshData",
      "type": "object",
      "required": ["accessToken", "refreshToken", "accessExpiresAt"],
      "properties": {
        "accessToken": { "type": "string", "x-redaction": "secret" },
        "refreshToken": { "type": "string", "x-redaction": "secret" },
        "accessExpiresAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
