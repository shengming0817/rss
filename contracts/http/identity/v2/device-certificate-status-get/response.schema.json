{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityDeviceCertificateStatusGetResponse",
  "description": "LocalOnly desired authorization lineage and reported certificate status.",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "title": "IdentityDeviceCertificateStatusGetData",
      "type": "object",
      "required": [
        "desired",
        "observedGeneration",
        "conditions"
      ],
      "properties": {
        "desired": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/desired"
            }
          ]
        },
        "observedGeneration": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "desired": {
      "title": "IdentityDeviceCertificateStatusGetDesired",
      "type": "object",
      "required": [
        "generation",
        "authorizationReceiptId",
        "activeCommand"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "authorizationReceiptId": {
          "$ref": "rss://component/identity/v1/authorization-receipt-id",
          "x-redaction": "internal"
        },
        "activeCommand": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/activeCommand"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "activeCommand": {
      "title": "IdentityDeviceCertificateStatusGetActiveCommand",
      "type": "object",
      "required": [
        "fenceEpoch",
        "state"
      ],
      "properties": {
        "fenceEpoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "published",
            "received"
          ]
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "title": "IdentityDeviceCertificateStatusGetCondition",
      "type": "object",
      "required": [
        "type",
        "status",
        "reason",
        "observedGeneration",
        "lastTransitionAt"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Ready",
            "Reconciling",
            "PendingDevice",
            "Degraded",
            "Quarantined",
            "Deleting"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "True",
            "False",
            "Unknown"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "DesiredAccepted",
            "CommandQueued",
            "AwaitingDevice",
            "DeviceReported",
            "StateMatches",
            "StateDrift",
            "CommandRejected",
            "CommandTimedOut",
            "ProtocolViolation",
            "QuarantinedByOperator",
            "DeletionPending",
            "DeletionComplete",
            "ArtifactUnavailable",
            "TransportUnavailable"
          ]
        },
        "observedGeneration": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "lastTransitionAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
