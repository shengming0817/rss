{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityLoginResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "title": "IdentityLoginData",
      "type": "object",
      "required": ["sessionId", "expiresAt"],
      "properties": {
        "sessionId": { "type": "string", "x-redaction": "secret" },
        "expiresAt": { "type": "integer", "format": "int64" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
