{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityPoliciesUpdateResponse",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "title": "IdentityPolicyView",
      "type": "object",
      "required": [
        "policyId",
        "version",
        "contractId",
        "permission",
        "effectiveFrom",
        "rules"
      ],
      "properties": {
        "policyId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "contractId": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "effectiveFrom": {
          "type": "integer",
          "format": "int64"
        },
        "effectiveUntil": {
          "type": "integer",
          "format": "int64"
        },
        "rules": {
          "type": "array",
          "items": {
            "title": "IdentityPolicyRuleView",
            "type": "object",
            "required": [
              "condition",
              "effect"
            ],
            "properties": {
              "condition": {
                "title": "IdentityPolicyConditionView",
                "type": "object",
                "required": [
                  "attribute",
                  "operator"
                ],
                "properties": {
                  "attribute": {
                    "type": "string"
                  },
                  "operator": {
                    "$ref": "rss://component/identity/v1/common-abac-operator"
                  }
                },
                "additionalProperties": false
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny"
                ]
              },
              "obligations": {
                "title": "IdentityPolicyObligationsView",
                "type": "object",
                "properties": {
                  "rowScope": {
                    "type": "string",
                    "enum": [
                      "selfOnly",
                      "device",
                      "tenant"
                    ]
                  },
                  "fieldMask": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
