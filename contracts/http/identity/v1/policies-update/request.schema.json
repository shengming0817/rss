            "required": ["attribute", "operator"],
            "properties": {
              "attribute": { "type": "string" },
              "operator": {
                "title": "IdentityPolicyUpdateOperator",
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["eq"] },
                      "value": { "type": "string", "maxLength": 256, "description": "Wire bound is Unicode code points (JSON Schema maxLength); domain authority is UTF-8 bytes ≤ 256 (Hard unit align deferred #1947)." },
                      "pattern": false,
                      "attribute": false
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["ne"] },
                      "value": { "type": "string", "maxLength": 256, "description": "Wire bound is Unicode code points (JSON Schema maxLength); domain authority is UTF-8 bytes ≤ 256 (Hard unit align deferred #1947)." },
                      "pattern": false,
                      "attribute": false
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "pattern"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["like"] },
                      "value": false,
                      "pattern": { "type": "string" },
                      "attribute": false
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["gt"] },
                      "value": { "type": "string", "maxLength": 256, "description": "Wire bound is Unicode code points (JSON Schema maxLength); domain authority is UTF-8 bytes ≤ 256 (Hard unit align deferred #1947)." },
                      "pattern": false,
                      "attribute": false
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["lt"] },
                      "value": { "type": "string", "maxLength": 256, "description": "Wire bound is Unicode code points (JSON Schema maxLength); domain authority is UTF-8 bytes ≤ 256 (Hard unit align deferred #1947)." },
                      "pattern": false,
                      "attribute": false
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "attribute"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["eqAttr"] },
                      "value": false,
                      "pattern": false,
                      "attribute": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "effect": { "type": "string", "enum": ["allow", "deny"] },
          "obligations": {
            "title": "IdentityPolicyUpdateObligations",
            "type": "object",
            "properties": {
              "rowScope": { "type": "string", "enum": ["selfOnly", "device", "tenant"] },
              "fieldMask": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
