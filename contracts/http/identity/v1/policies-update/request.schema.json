{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityPoliciesUpdateRequest",
  "type": "object",
  "required": ["expectedVersion", "contractId", "permission", "effectiveFrom", "rules"],
  "properties": {
    "expectedVersion": { "type": "integer", "format": "int32", "minimum": 1 },
    "contractId": { "type": "string" },
    "permission": { "type": "string" },
    "effectiveFrom": { "type": "integer", "format": "int64" },
    "effectiveUntil": { "type": "integer", "format": "int64" },
