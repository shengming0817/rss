{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityPoliciesListResponse",
  "type": "object",
  "required": ["data", "hasMore"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "title": "IdentityPolicyListView",
        "type": "object",
        "required": ["policyId", "version", "contractId", "permission", "effectiveFrom", "rules"],
        "properties": {
          "policyId": { "type": "string" },
          "version": { "type": "integer", "format": "int32", "minimum": 1 },
          "contractId": { "type": "string" },
          "permission": { "type": "string" },
          "effectiveFrom": { "type": "integer", "format": "int64" },
          "effectiveUntil": { "type": "integer", "format": "int64" },
          "rules": {
            "type": "array",
            "items": {
              "title": "IdentityPolicyListRule",
              "type": "object",
              "required": ["condition", "effect"],
              "properties": {
                "condition": {
                  "title": "IdentityPolicyListCondition",
                  "type": "object",
                  "required": ["attribute", "operator"],
                  "properties": {
                    "attribute": { "type": "string" },
                    "operator": {
                      "title": "IdentityPolicyListOperator",
                      "type": "object",
                      "required": ["kind"],
                      "properties": {
                        "kind": { "type": "string", "enum": ["eq", "ne", "like", "gt", "lt", "eqAttr"] },
                        "value": { "type": "string", "maxLength": 256, "x-defer-string-length-validation": true },
                        "pattern": { "type": "string" },
                        "attribute": {
                          "type": "string",
                          "enum": [
                            "principal.kind",
                            "principal.id",
                            "tenant.id",
                            "contract.id",
                            "permission",
                            "resource.id"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "effect": { "type": "string", "enum": ["allow", "deny"] },
                "obligations": {
                  "title": "IdentityPolicyListObligations",
                  "type": "object",
                  "properties": {
                    "rowScope": { "type": "string", "enum": ["selfOnly", "device", "tenant"] },
                    "fieldMask": { "type": "array", "items": { "type": "string" }, "default": [] }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "nextCursor": { "type": "string" },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
