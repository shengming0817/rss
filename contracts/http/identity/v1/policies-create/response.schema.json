      "title": "IdentityPolicyCreateView",
      "type": "object",
      "required": ["policyId", "version", "contractId", "permission", "effectiveFrom", "rules"],
      "properties": {
        "policyId": { "type": "string" },
        "version": { "type": "integer", "format": "int32", "minimum": 1 },
        "contractId": { "type": "string" },
        "permission": { "type": "string" },
        "effectiveFrom": { "type": "integer", "format": "int64" },
        "effectiveUntil": { "type": "integer", "format": "int64" },
        "rules": {
          "type": "array",
          "items": {
            "title": "IdentityPolicyCreateRuleView",
            "type": "object",
            "required": ["condition", "effect"],
            "properties": {
              "condition": {
                "title": "IdentityPolicyCreateConditionView",
                "type": "object",
                "required": ["attribute", "operator"],
                "properties": {
                  "attribute": { "type": "string" },
                  "operator": {
                    "title": "IdentityPolicyCreateOperatorView",
                    "type": "object",
                    "required": ["kind"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["eq", "ne", "like", "gt", "lt", "eqAttr"] },
                      "value": { "type": "string", "maxLength": 256, "description": "Wire bound is Unicode code points (JSON Schema maxLength); domain authority is UTF-8 bytes ≤ 256 (Hard unit align deferred #1947).", "x-defer-string-length-validation": true },
                      "pattern": { "type": "string" },
                      "attribute": {
                        "type": "string",
                        "enum": [
                          "principal.kind",
                          "principal.id",
                          "tenant.id",
                          "contract.id",
                          "permission",
                          "resource.id"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "effect": { "type": "string", "enum": ["allow", "deny"] },
              "obligations": {
                "title": "IdentityPolicyCreateObligationsView",
                "type": "object",
                "properties": {
                  "rowScope": { "type": "string", "enum": ["selfOnly", "device", "tenant"] },
                  "fieldMask": { "type": "array", "items": { "type": "string" }, "default": [] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
