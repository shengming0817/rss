{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityPasswordChangeRequest",
  "type": "object",
  "required": ["currentPassword", "newPassword"],
  "properties": {
    "currentPassword": { "type": "string", "x-redaction": "secret" },
    "newPassword": {
      "type": "string",
      "minLength": 15,
      "maxLength": 64,
      "x-defer-string-length-validation": true,
      "x-redaction": "secret"
    }
  },
  "additionalProperties": false
}
