{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditListEntriesResponse",
  "type": "object",
  "required": ["data", "hasMore"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "title": "AuditEntryView",
        "type": "object",
        "required": ["seq", "tenantId", "actor", "actorKind", "action", "resourceKind", "resourceId", "outcome", "recordedAt", "entryHash"],
        "properties": {
          "seq": { "type": "integer", "format": "int64" },
          "tenantId": { "type": "string" },
          "actor": { "type": "string", "x-pii": "generic" },
          "actorKind": { "type": "string" },
          "action": { "type": "string" },
          "resourceKind": { "type": "string" },
          "resourceId": { "type": "string", "x-pii": "generic" },
          "outcome": { "type": "string" },
          "recordedAt": { "type": "integer", "format": "int64", "description": "Unix seconds (UTC)" },
          "entryHash": { "type": "string", "description": "Opaque per-entry HMAC integrity fingerprint (base64url); not independently verifiable without the chain key." }
        },
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": "string",
      "format": "rss-page-cursor-v1",
      "description": "Opaque canonical base64url-no-pad page cursor bound to this contract version, cursor kind, tenant, and sequence position."
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
