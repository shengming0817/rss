{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeInventoryResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "title": "RuntimeInventoryData",
      "type": "object",
      "required": [
        "schemaVersion",
        "assemblyLockDigest",
        "runtimePlanFingerprint",
        "activatedWorkflows",
        "domains",
        "listeners",
        "providerPosture",
        "placements"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 3 },
        "assemblyLockDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "buildMetadata": { "$ref": "#/definitions/RuntimeBuildMetadata" },
        "runtimePlanFingerprint": { "$ref": "#/definitions/Sha256Fingerprint" },
        "officialProfile": { "$ref": "#/definitions/RuntimeOfficialProfile" },
        "activatedWorkflows": {
          "description": "The sealed non-disabled workflow set in stable runtime-plan order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeActivatedWorkflow" }
        },
        "domains": {
          "description": "Assembly domains in declaration order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeDomain" }
        },
        "listeners": {
          "description": "Listeners in stable listener-id order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeListener" }
        },
        "providerPosture": {
          "description": "Provider posture entries in stable provider-id order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeProviderPosture" }
        },
        "placements": {
          "description": "Placements in stable domain then workload order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimePlacement" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Sha256Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RuntimeBuildMetadata": {
      "title": "RuntimeBuildMetadata",
      "description": "Launch-supplied build metadata reported by the process. This is not an in-process OCI or SLSA verification receipt.",
      "type": "object",
      "required": ["sourceRevision", "imageDigest"],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "imageDigest": { "$ref": "#/definitions/Sha256Fingerprint" }
      },
      "additionalProperties": false
    },
    "RuntimeOfficialProfile": {
      "title": "RuntimeOfficialProfile",
      "type": "object",
      "required": ["profile", "configDigest", "routes", "workers", "probes"],
      "properties": {
        "profile": { "type": "string", "enum": ["core"] },
        "configDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "routes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "workers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "probes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "RuntimeDomain": {
      "type": "string",
      "enum": ["identity", "settings", "audit", "contractreg", "syshealth"]
    },
    "RuntimeListenerKind": {
      "type": "string",
      "enum": ["primary", "internal", "health", "admin"]
    },
    "RuntimeAuthScheme": {
      "type": "string",
      "enum": ["noAuth", "rssAccessToken", "federatedAccessToken", "mtls", "serviceToken"]
    },
    "RuntimeListenerEndpoint": {
      "title": "RuntimeListenerEndpoint",
      "type": "object",
      "required": ["scheme", "host", "port"],
      "properties": {
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "RuntimeListener": {
      "title": "RuntimeListener",
      "type": "object",
      "required": ["id", "kind", "endpoint", "authScheme"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/RuntimeListenerKind" },
        "endpoint": { "$ref": "#/definitions/RuntimeListenerEndpoint" },
        "authScheme": { "$ref": "#/definitions/RuntimeAuthScheme" }
      },
      "additionalProperties": false
    },
    "RuntimeProviderPosture": {
      "title": "RuntimeProviderPosture",
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["unobserved", "ready", "degraded", "unavailable"] }
      },
      "additionalProperties": false
    },
    "RuntimeActivatedWorkflow": {
      "title": "RuntimeActivatedWorkflow",
      "description": "A sealed non-disabled workflow activation.",
      "oneOf": [
        { "$ref": "#/definitions/RuntimeActivatedProjectionCapture" },
        { "$ref": "#/definitions/RuntimeActivatedProjectionExecuting" },
        { "$ref": "#/definitions/RuntimeActivatedSaga" }
      ]
    },
    "RuntimeActivatedProjectionCapture": {
      "title": "RuntimeActivatedProjectionCapture",
      "type": "object",
      "required": [
        "mode",
        "id",
        "definitionVersion",
        "definitionSchemaDigest",
        "activation"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["projection"] },
        "id": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "definitionSchemaDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activation": {
          "type": "string",
          "enum": ["capture-only"]
        }
      },
      "additionalProperties": false
    },
    "RuntimeActivatedProjectionExecuting": {
      "title": "RuntimeActivatedProjectionExecuting",
      "type": "object",
      "required": ["mode", "id", "definitionVersion", "definitionSchemaDigest", "activation", "targetGeneration", "workerStatus"],
      "properties": {
        "mode": { "type": "string", "enum": ["projection"] },
        "id": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "definitionSchemaDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activation": { "type": "string", "enum": ["shadow", "active"] },
        "targetGeneration": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workerStatus": { "$ref": "#/definitions/RuntimeProjectionWorkerStatus" }
      },
      "additionalProperties": false
    },
    "RuntimeProjectionSelectedGeneration": {
      "title": "RuntimeProjectionSelectedGeneration",
      "oneOf": [
        { "$ref": "#/definitions/RuntimeProjectionSelectedGenerationNone" },
        { "$ref": "#/definitions/RuntimeProjectionSelectedGenerationUniform" },
        { "$ref": "#/definitions/RuntimeProjectionSelectedGenerationMixed" }
      ]
    },
    "RuntimeProjectionSelectedGenerationNone": {
      "title": "RuntimeProjectionSelectedGenerationNone", "type": "object", "required": ["state"],
      "properties": { "state": { "type": "string", "enum": ["none"] } }, "additionalProperties": false
    },
    "RuntimeProjectionSelectedGenerationUniform": {
      "title": "RuntimeProjectionSelectedGenerationUniform", "type": "object", "required": ["state", "generation"],
      "properties": { "state": { "type": "string", "enum": ["uniform"] }, "generation": { "type": "string", "minLength": 1, "maxLength": 256 } }, "additionalProperties": false
    },
    "RuntimeProjectionSelectedGenerationMixed": {
      "title": "RuntimeProjectionSelectedGenerationMixed", "type": "object", "required": ["state"],
      "properties": { "state": { "type": "string", "enum": ["mixed"] } }, "additionalProperties": false
    },
    "RuntimeProjectionRetryableReason": {
      "type": "string", "enum": ["checkpoint-unread", "checkpoint-unsaved", "dead-letter-unsaved", "apply-transient", "commit-unknown", "source-transient", "quarantine-persistence"]
    },
    "RuntimeProjectionQuarantineReason": {
      "type": "string", "enum": ["target-definition-drift", "input-binding-drift", "tenant-drift", "payload-malformed", "payload-value-invalid", "version-regression", "provider-invariant", "provider-permanent", "conflict", "apply-out-of-order", "rollback-failed", "source-out-of-order"]
    },
    "RuntimeProjectionRetryableReasons": {
      "title": "RuntimeProjectionRetryableReasons", "oneOf": [
        { "$ref": "#/definitions/RuntimeProjectionRetryableReasonsUniform" }, { "$ref": "#/definitions/RuntimeProjectionRetryableReasonsMixed" }
      ]
    },
    "RuntimeProjectionRetryableReasonsUniform": {
      "title": "RuntimeProjectionRetryableReasonsUniform", "type": "object", "required": ["state", "reason"],
      "properties": { "state": { "type": "string", "enum": ["uniform"] }, "reason": { "$ref": "#/definitions/RuntimeProjectionRetryableReason" } }, "additionalProperties": false
    },
    "RuntimeProjectionRetryableReasonsMixed": {
      "title": "RuntimeProjectionRetryableReasonsMixed", "type": "object", "required": ["state"],
      "properties": { "state": { "type": "string", "enum": ["mixed"] } }, "additionalProperties": false
    },
    "RuntimeProjectionQuarantineReasons": {
      "title": "RuntimeProjectionQuarantineReasons", "oneOf": [
        { "$ref": "#/definitions/RuntimeProjectionQuarantineReasonsUniform" }, { "$ref": "#/definitions/RuntimeProjectionQuarantineReasonsMixed" }
      ]
    },
    "RuntimeProjectionQuarantineReasonsUniform": {
      "title": "RuntimeProjectionQuarantineReasonsUniform", "type": "object", "required": ["state", "reason"],
      "properties": { "state": { "type": "string", "enum": ["uniform"] }, "reason": { "$ref": "#/definitions/RuntimeProjectionQuarantineReason" } }, "additionalProperties": false
    },
    "RuntimeProjectionQuarantineReasonsMixed": {
      "title": "RuntimeProjectionQuarantineReasonsMixed", "type": "object", "required": ["state"],
      "properties": { "state": { "type": "string", "enum": ["mixed"] } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerStatus": {
      "title": "RuntimeProjectionWorkerStatus", "oneOf": [
        { "$ref": "#/definitions/RuntimeProjectionWorkerStarting" }, { "$ref": "#/definitions/RuntimeProjectionWorkerHealthy" },
        { "$ref": "#/definitions/RuntimeProjectionWorkerRetryable" }, { "$ref": "#/definitions/RuntimeProjectionWorkerQuarantined" },
        { "$ref": "#/definitions/RuntimeProjectionWorkerMixed" }, { "$ref": "#/definitions/RuntimeProjectionWorkerUnavailable" },
        { "$ref": "#/definitions/RuntimeProjectionWorkerStopped" }
      ]
    },
    "RuntimeProjectionWorkerStarting": {
      "title": "RuntimeProjectionWorkerStarting", "type": "object", "required": ["state"], "properties": { "state": { "type": "string", "enum": ["starting"] } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerHealthy": {
      "title": "RuntimeProjectionWorkerHealthy", "type": "object", "required": ["state", "selectedGeneration", "maxLag"],
      "properties": { "state": { "type": "string", "enum": ["healthy"] }, "selectedGeneration": { "$ref": "#/definitions/RuntimeProjectionSelectedGeneration" }, "maxLag": { "type": "integer", "minimum": 0 } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerRetryable": {
      "title": "RuntimeProjectionWorkerRetryable", "type": "object", "required": ["state", "selectedGeneration", "maxLag", "reasons"],
      "properties": { "state": { "type": "string", "enum": ["retryable"] }, "selectedGeneration": { "$ref": "#/definitions/RuntimeProjectionSelectedGeneration" }, "maxLag": { "type": "integer", "minimum": 0 }, "reasons": { "$ref": "#/definitions/RuntimeProjectionRetryableReasons" } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerQuarantined": {
      "title": "RuntimeProjectionWorkerQuarantined", "type": "object", "required": ["state", "selectedGeneration", "maxLag", "reasons"],
      "properties": { "state": { "type": "string", "enum": ["quarantined"] }, "selectedGeneration": { "$ref": "#/definitions/RuntimeProjectionSelectedGeneration" }, "maxLag": { "type": "integer", "minimum": 0 }, "reasons": { "$ref": "#/definitions/RuntimeProjectionQuarantineReasons" } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerMixed": {
      "title": "RuntimeProjectionWorkerMixed", "type": "object", "required": ["state", "selectedGeneration", "maxLag", "retryableReasons", "quarantineReasons"],
      "properties": { "state": { "type": "string", "enum": ["mixed"] }, "selectedGeneration": { "$ref": "#/definitions/RuntimeProjectionSelectedGeneration" }, "maxLag": { "type": "integer", "minimum": 0 }, "retryableReasons": { "$ref": "#/definitions/RuntimeProjectionRetryableReasons" }, "quarantineReasons": { "$ref": "#/definitions/RuntimeProjectionQuarantineReasons" } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerUnavailable": {
      "title": "RuntimeProjectionWorkerUnavailable", "type": "object", "required": ["state", "reason"],
      "properties": { "state": { "type": "string", "enum": ["unavailable"] }, "reason": { "type": "string", "enum": ["startup-observation", "sweep-incomplete", "tenant-observation"] } }, "additionalProperties": false
    },
    "RuntimeProjectionWorkerStopped": {
      "title": "RuntimeProjectionWorkerStopped", "type": "object", "required": ["state", "stopClass", "reason"],
      "properties": { "state": { "type": "string", "enum": ["stopped"] }, "stopClass": { "type": "string", "enum": ["fatal"] }, "reason": { "type": "string", "enum": ["runtime-build-failed", "worker-panicked", "tenant-catalog-unavailable", "selected-generation-unavailable", "selected-generation-identity-invalid", "invalid-tenant", "tenant-quarantine-unavailable", "startup-source-unavailable", "projection-outcome-invalid", "coordinate-overflow", "target-config-invalid"] } }, "additionalProperties": false
    },
    "RuntimeActivatedSaga": {
      "title": "RuntimeActivatedSaga",
      "type": "object",
      "required": [
        "mode",
        "id",
        "definitionVersion",
        "definitionSchemaDigest",
        "activation"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["saga"] },
        "id": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "definitionSchemaDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activation": { "type": "string", "enum": ["active"] }
      },
      "additionalProperties": false
    },
    "RuntimePlacement": {
      "title": "RuntimePlacement",
      "type": "object",
      "required": ["domain", "workload", "mode", "readiness"],
      "properties": {
        "domain": { "$ref": "#/definitions/RuntimeDomain" },
        "workload": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["local", "remote"] },
        "endpoint": { "$ref": "#/definitions/RuntimeListenerEndpoint" },
        "spiffeIdentity": { "type": "string", "minLength": 1 },
        "readiness": {
          "type": "string",
          "enum": ["ready", "mtls-source-unavailable"]
        }
      },
      "additionalProperties": false
    }
  }
}
