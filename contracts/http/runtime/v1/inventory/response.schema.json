{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeInventoryResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "title": "RuntimeInventoryData",
      "type": "object",
      "required": [
        "schemaVersion",
        "assemblyFingerprint",
        "runtimePlanFingerprint",
        "activatedWorkflows",
        "domains",
        "listeners",
        "providerPosture",
        "placements"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "assemblyFingerprint": { "$ref": "#/definitions/Sha256Fingerprint" },
        "buildMetadata": { "$ref": "#/definitions/RuntimeBuildMetadata" },
        "runtimePlanFingerprint": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activatedWorkflows": {
          "description": "The sealed non-disabled workflow set in stable runtime-plan order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeActivatedWorkflow" }
        },
        "domains": {
          "description": "Assembly domains in declaration order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeDomain" }
        },
        "listeners": {
          "description": "Listeners in stable listener-id order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeListener" }
        },
        "providerPosture": {
          "description": "Provider posture entries in stable provider-id order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimeProviderPosture" }
        },
        "placements": {
          "description": "Placements in stable domain then workload order.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuntimePlacement" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Sha256Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RuntimeBuildMetadata": {
      "title": "RuntimeBuildMetadata",
      "description": "Launch-supplied build metadata reported by the process. This is not an in-process OCI or SLSA verification receipt.",
      "type": "object",
      "required": ["sourceRevision", "imageDigest"],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "imageDigest": { "$ref": "#/definitions/Sha256Fingerprint" }
      },
      "additionalProperties": false
    },
    "RuntimeDomain": {
      "type": "string",
      "enum": ["identity", "settings", "audit", "contractreg", "syshealth"]
    },
    "RuntimeListenerKind": {
      "type": "string",
      "enum": ["primary", "internal", "health", "admin"]
    },
    "RuntimeAuthScheme": {
      "type": "string",
      "enum": ["noAuth", "rssAccessToken", "federatedAccessToken", "mtls", "serviceToken"]
    },
    "RuntimeListenerEndpoint": {
      "title": "RuntimeListenerEndpoint",
      "type": "object",
      "required": ["scheme", "host", "port"],
      "properties": {
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "RuntimeListener": {
      "title": "RuntimeListener",
      "type": "object",
      "required": ["id", "kind", "endpoint", "authScheme"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/RuntimeListenerKind" },
        "endpoint": { "$ref": "#/definitions/RuntimeListenerEndpoint" },
        "authScheme": { "$ref": "#/definitions/RuntimeAuthScheme" }
      },
      "additionalProperties": false
    },
    "RuntimeProviderPosture": {
      "title": "RuntimeProviderPosture",
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["ready", "degraded", "unavailable"] }
      },
      "additionalProperties": false
    },
    "RuntimeActivatedWorkflow": {
      "title": "RuntimeActivatedWorkflow",
      "description": "A sealed non-disabled workflow activation.",
      "oneOf": [
        { "$ref": "#/definitions/RuntimeActivatedProjection" },
        { "$ref": "#/definitions/RuntimeActivatedSaga" }
      ]
    },
    "RuntimeActivatedProjection": {
      "title": "RuntimeActivatedProjection",
      "type": "object",
      "required": [
        "mode",
        "id",
        "definitionVersion",
        "definitionSchemaDigest",
        "activation"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["projection"] },
        "id": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "definitionSchemaDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activation": {
          "type": "string",
          "enum": ["capture-only", "shadow", "active"]
        }
      },
      "additionalProperties": false
    },
    "RuntimeActivatedSaga": {
      "title": "RuntimeActivatedSaga",
      "type": "object",
      "required": [
        "mode",
        "id",
        "definitionVersion",
        "definitionSchemaDigest",
        "activation"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["saga"] },
        "id": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "definitionSchemaDigest": { "$ref": "#/definitions/Sha256Fingerprint" },
        "activation": { "type": "string", "enum": ["active"] }
      },
      "additionalProperties": false
    },
    "RuntimePlacement": {
      "title": "RuntimePlacement",
      "type": "object",
      "required": ["domain", "workload", "mode", "readiness"],
      "properties": {
        "domain": { "$ref": "#/definitions/RuntimeDomain" },
        "workload": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["local", "remote"] },
        "endpoint": { "$ref": "#/definitions/RuntimeListenerEndpoint" },
        "spiffeIdentity": { "type": "string", "minLength": 1 },
        "readiness": {
          "type": "string",
          "enum": [
            "ready",
            "mtls-source-unavailable",
            "peer-endpoint-unresolved",
            "peer-endpoint-unavailable"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
