{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsConfigProjection",
  "description": "Canonical materialized row and dedupe receipt carriers for settings.config-projection.",
  "type": "object",
  "required": ["dedupeReceipt", "materializedRow"],
  "properties": {
    "dedupeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "projectionId",
        "generation",
        "sourceEventId",
        "sourceLsn",
        "factDigest",
        "actor",
        "purpose",
        "appliedAt"
      ],
      "properties": {
        "tenantId": { "type": "string", "format": "uuid" },
        "projectionId": { "type": "string", "const": "settings.config-projection" },
        "generation": { "$ref": "#/definitions/generation" },
        "sourceEventId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceLsn": { "type": "integer", "minimum": 0 },
        "factDigest": { "$ref": "#/definitions/sha256Bytes" },
        "actor": {
          "type": "string",
          "enum": ["rss-projection-worker", "rss-projection-replay"],
          "x-redaction": "internal"
        },
        "purpose": {
          "type": "string",
          "enum": ["background-shadow", "operator-replay"]
        },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "oneOf": [
        {
          "properties": {
            "actor": { "const": "rss-projection-worker", "x-redaction": "internal" },
            "purpose": { "const": "background-shadow" }
          }
        },
        {
          "properties": {
            "actor": { "const": "rss-projection-replay", "x-redaction": "internal" },
            "purpose": { "const": "operator-replay" }
          }
        }
      ]
    },
    "materializedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "projectionId",
        "generation",
        "configKey",
        "configVersion",
        "changeKind",
        "sourceEventId",
        "sourceLsn",
        "sourceOccurredAtSecs",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "tenantId": { "type": "string", "format": "uuid" },
        "projectionId": { "type": "string", "const": "settings.config-projection" },
        "generation": { "$ref": "#/definitions/generation" },
        "configKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-redaction": "internal"
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "changeKind": { "type": "string", "enum": ["published", "rolledBack", "deleted"] },
        "sourceEventId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceLsn": { "type": "integer", "minimum": 0 },
        "sourceOccurredAtSecs": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256Bytes": {
      "description": "Lowercase hexadecimal encoding of the persisted 32-byte SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
