{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityPolicyUpdatedPayload",
  "type": "object",
  "required": ["policyId", "changeKind", "version", "contractId", "permission", "updatedBy", "actorKind", "tenantId", "occurredAt"],
  "properties": {
    "policyId": { "type": "string" },
    "changeKind": {
      "type": "string",
      "enum": ["created", "updated", "deactivated"]
    },
    "version": { "type": "integer", "format": "int32", "minimum": 1 },
    "contractId": { "type": "string" },
    "permission": { "type": "string" },
    "updatedBy": { "type": "string", "format": "uuid", "x-pii": "generic" },
    "actorKind": {
      "type": "string",
      "enum": ["user", "device", "admin", "superAdmin", "service", "anonymous"]
    },
    "tenantId": { "type": "string" },
    "occurredAt": { "type": "integer", "format": "int64" }
  },
  "additionalProperties": false
}
