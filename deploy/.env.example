# RSS demo stack 非 Secret 环境变量（#1134）。Secret fixture 位于 deploy/demo-secrets，
# serving 只挂载 runtime-serving-secret-bundle，不接受 Secret env 或旧 PG password-file env。
#
# ⚠️ 全部为**演示占位值**——生产须逐项替换（OIDC/Vault 指向真实服务、口令/密钥重新生成）。
# server 对缺失的必填变量 fail-fast（不静默 noop）：任一缺失 → 进程启动即 Err 退出（含变量名）。
#
# 变量来源单源 = assemblies/runtime/src/lib.rs 的 build_* 读取点（fail-fast 站点）。
#
# Egress TLS（#1710）：禁止 RSS_*_ALLOW_PLAINTEXT（AMQP/REDIS/S3）与 RSS_PG_SSL_MODE——出现即启动
# fail-fast。始终 Deny + VerifyFull；私有 CA 路径必填（见下方）。仅 ingress 保留
# RSS_LISTENER_ALLOW_PLAINTEXT=dev-container（#1649 compose 端口映射边界）。
# 前置：bash deploy/demo-tls/generate-demo-cas.sh（产出挂载到 /run/rss-demo-tls/...）。

# ── PostgreSQL（postgres 容器初始化 + server 连接）───────────────────────────────────────────────
# postgres:16-alpine 初始化 owner（POSTGRES_*）：仅用于容器 init，不给 server 使用。
POSTGRES_USER=postgres
POSTGRES_DB=rss
# init script 给固定 serving role 开 LOGIN：非 superuser + NOBYPASSRLS；直连 rss_app 运行期 DML，无 DDL/CREATEROLE。
POSTGRES_APP_USER=rss_app
# 独立 migration task 使用短生命周期 migrator 凭据；长期 server pool 不挂载该角色的文件。
RSS_PG_MIGRATOR_USERNAME=postgres
# server 连接用（RSS_PG_*）。HOST=compose 服务名 postgres；端口 5432；必须使用 NOBYPASSRLS app login。
RSS_PG_HOST=postgres
RSS_PG_PORT=5432
RSS_PG_DATABASE=rss
RSS_PG_USERNAME=rss_app
# writer/reader 默认各 5，保持 LocalOnly serving 总 ceiling 为 10；生产可独立调节（每项 1..=100）。
RSS_PG_MAX_CONNECTIONS=5
# LocalOnly tenant reader 必须使用独立固定角色；不从 writer 凭据回退。
RSS_PG_READ_USERNAME=rss_app_read
RSS_PG_READ_MAX_CONNECTIONS=5
# DLX archive-before-purge 专用长期窄角色；不得复用 rss_app/migrator。
RSS_PG_DLX_ARCHIVER_USERNAME=rss_dlx_archiver
RSS_PG_DLX_VERIFIER_USERNAME=rss_dlx_verifier
RSS_PG_DLX_PURGER_USERNAME=rss_dlx_purger
# PG 始终 VerifyFull（#1710）；RSS_PG_SSL_MODE 已禁止。演示栈挂载 demo-tls 私有 CA。
RSS_PG_SSL_ROOT_CERT_PATH=/run/rss-demo-tls/postgres/ca.pem
# 可选：configs_ready DB 采样周期秒（默认 5，范围 1..=300）。
# RSS_PG_READINESS_SAMPLE_INTERVAL_SECS=5
# 可选：auth_grant_sweeper 过期认证授权根清理周期毫秒（默认 300000，最小 1000；误配 warn + 默认）。
# RSS_AUTH_GRANT_SWEEP_INTERVAL_MS=300000
# 可选安全豁免：临时允许启动时存在 legacy plaintext ConfigValue 行（默认 false）。
# 仅供 backfill 前短期评估；生产应保持未设置 / false，让 protection_scheme=0 阻断启动。
# RSS_SETTINGS_ALLOW_LEGACY_PLAINTEXT_CONFIG_VALUES=false

# ── Redis（distributed lock provider + readiness；缺失 / PING 失败启动 fail-fast）──────────────────
# compose 服务名 redis；bundle 必须 rediss://。RSS_REDIS_ALLOW_PLAINTEXT 已禁止（#1710）。
RSS_REDIS_CA_CERT_PEM_PATH=/run/rss-demo-tls/redis/ca.pem
# RSS_REDIS_URL is supplied only by demo-secrets/runtime-serving-secret-bundle.
# 可选：redis_ready PING 采样周期秒（默认 5，范围 1..=30）。
# RSS_REDIS_READINESS_SAMPLE_INTERVAL_SECS=5

# ── S3 / MinIO（object-store runtime canary；缺失 / canary 失败会阻断 readyz）─────────────────────
# compose 服务名 minio；endpoint 必须 https://。RSS_S3_ALLOW_PLAINTEXT 已禁止（#1710）。
RSS_S3_CA_CERT_PEM_PATH=/run/rss-demo-tls/minio/CAs/rss-demo-s3-ca.pem
RSS_S3_ENDPOINT_URL=https://minio:9000
RSS_S3_BUCKET=rss-demo
# RSS_S3_ACCESS_KEY_ID / RSS_S3_SECRET_ACCESS_KEY are supplied only by the serving bundle.
RSS_S3_FORCE_PATH_STYLE=true
# 独立 DLX WORM bucket + AWS 官方 provider chain workload credentials（demo 由 minio-init 创建）。
RSS_DLX_ARCHIVE_S3_BUCKET=rss-demo-dlx-archive
AWS_SHARED_CREDENTIALS_FILE=/run/rss-demo-secrets/aws-credentials
# 可选：s3_object_store_ready canary 周期 / 单轮超时秒（默认 60 / 5；演示缩短反馈）。
RSS_S3_CANARY_INTERVAL_SECS=5
RSS_S3_CANARY_TIMEOUT_SECS=2

# ── Event transport（durable-shared AMQP；必须 amqps + 独立凭据/vhost）──────────────────────────
RSS_TOPOLOGY=durable-shared
# compose 服务名 rabbitmq；bundle 必须 amqps://。RSS_AMQP_ALLOW_PLAINTEXT 已禁止（#1710）。
RSS_AMQP_CA_CERT_PEM_PATH=/run/rss-demo-tls/rabbitmq/ca.pem
# AMQP URL, tenant-authority HMAC and command-idempotency keyring are bundle-only.
# 可选：authority token TTL / clock skew 容忍（秒），默认 3600 / 60；clock skew 上限 300。
# RSS_TENANT_AUTHORITY_TTL_SECS=3600
# RSS_TENANT_AUTHORITY_CLOCK_SKEW_SECS=60
# DLX v3 HOT replay capsule 加密用 Vault Transit key name（KeyProvider/Vault transit）。
RSS_DLX_PAYLOAD_KEY_NAME=rss-dlx-payload
# DLX cold canonical envelope 使用独立 Vault Transit key；不得与 hot key 相同。
RSS_DLX_ARCHIVE_KEY_NAME=rss-dlx-archive

# ── Outbound domain transport（SPIFFE/mTLS；#1649 前演示栈不提供 SPIRE fixture）───────────────
# ★ stock runtime / 现有 compose 只能全 Local。缺省（不设 PLACEMENT_WORKLOAD，或 workload =
#   assembly identity）→ Local，不强制 outbound domain transport；deploy/smoke.sh 在 all-Local
#   下直接继续七闭环，不因缺 SPIRE 而 SKIP。
# ★ 勿在现有 compose 解开下方 Remote 块。stock assembly 仍把 identity/settings/audit 挂在
#   primary/admin listener；若设 Remote workload，启动期 `reject_remote_on_local_listeners`
#   会 fail-closed（Remote 域仍挂本地 listener → 进程拒绝启动）。Remote 须先从 listener 摘域，
#   再配 SPIFFE/URL/allow-set；现有 compose 未做摘域，解开即用会启动失败。
# Remote 参考（仅文档；#1649 补 SPIRE server/agent、Workload API socket mount、registration
# entry、HTTPS peer 与 allow-set 后，且 listener 已摘域，才可在非 stock compose 启用）：
# SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
# RSS_IDENTITY_DOMAIN_PLACEMENT_WORKLOAD=peer-cell   # 勿启用：stock listener 仍挂域 → fail-closed
# RSS_SETTINGS_DOMAIN_PLACEMENT_WORKLOAD=runtime
# RSS_AUDIT_DOMAIN_PLACEMENT_WORKLOAD=runtime
# RSS_DOMAIN_TRANSPORT_MTLS_LOCAL_SPIFFE_ID=spiffe://example.org/ns/rss/sa/runtime
# RSS_IDENTITY_DOMAIN_TRANSPORT_URL=https://identity.internal/rpc
# RSS_IDENTITY_DOMAIN_TRANSPORT_MTLS_SPIFFE_ALLOW_SET=spiffe://example.org/ns/rss/sa/identity

# ── Listener bind 地址（4 个标准 listener，host:port；缺失 fail-fast）─────────────────────────────
# listener 明文默认拒绝；演示栈显式选择 dev-container，允许 0.0.0.0 wildcard bind 供 compose 端口映射。
RSS_LISTENER_ALLOW_PLAINTEXT=dev-container
# 0.0.0.0 = 容器内监听所有网卡（compose 端口映射才可达宿主）；生产应使用 mTLS/TLS 或 loopback 明文 opt-in。
RSS_PRIMARY_LISTEN_ADDR=0.0.0.0:8080
# service-token listener is deliberately loopback-only; it is not published by compose.
RSS_INTERNAL_LISTEN_ADDR=127.0.0.1:8081
RSS_ADMIN_LISTEN_ADDR=0.0.0.0:8082
RSS_HEALTH_LISTEN_ADDR=0.0.0.0:8083
# 全 listener 共用的完整入站请求预算（毫秒，必填非零）；覆盖 body/auth/handler/downstream future。
RSS_HTTP_SERVER_REQUEST_BUDGET_MS=30000
# Listener 的 token profile 在启动期固定，不能由 token/header/query 选择。
RSS_PRIMARY_TOKEN_PROFILE=rss-access
RSS_ADMIN_TOKEN_PROFILE=rss-access
RSS_INTERNAL_AUTH_SCHEME=service-token

# ── 可观测性导出（#1253）─────────────────────────────────────────────────────────────────────────
# OTLP/gRPC trace 导出 collector 端点（按需开启）。未设 → 仅 fmt 日志、不导出 trace（演示默认留空）。
# https://… → TLS（生产）；http://… 仅 loopback host 明文 opt-in；非 loopback 明文 / 非 http(s) → 启动 fail-fast。
# Prometheus /metrics 无需此变量（PromExporter 随 run() 必装，scrape /health/v1/metrics）。
# RSS_OTEL_ENDPOINT=http://localhost:4317

# ── RSS Access profile（ES256；签发与验签单源）──────────────────────────────────────────────────
RSS_ACCESS_TOKEN_ISSUER=https://rss-access.demo.local/
RSS_ACCESS_TOKEN_AUDIENCE=rss-primary
# RSS 自签 access token 固定为 grant-bound User，并要求 sid/jti/auth_time/authn_epoch；非 User 使用 Federated profile。
# Vault Transit sign key 名 = JOSE kid（active）；JWKS 只允许有非空 kid 的 P-256 ES256 keys。
RSS_ACCESS_TOKEN_SIGNING_ACTIVE_KEY_ID=rss-access-es256
# 可选轮换：RSS_ACCESS_TOKEN_SIGNING_NEXT_KEY_ID /
# RSS_ACCESS_TOKEN_SIGNING_RETIRING（kid=unixSeconds,逗号分隔）/
# RSS_ACCESS_TOKEN_SIGNING_ROTATED_AT（有 retiring 时必填）/
# RSS_ACCESS_TOKEN_ROTATION_MODE=planned|emergency /
# RSS_ACCESS_TOKEN_ROTATION_CLOCK_SKEW_SECS（默认 60）/
# RSS_ACCESS_TOKEN_ROTATION_JWKS_PROPAGATION_SLO_SECS（默认 300）/
# RSS_ACCESS_TOKEN_ROTATION_MARGIN_SECS（默认 60）。
# planned：verify overlap 必须覆盖 TTL+skew+JWKS SLO+margin；emergency：跳过 overlap（事故切钥），
# 会打 warn 日志，readiness detail 标 emergency。两者都不含 kid 于错误/日志文案。
# export-vault-transit 会把 ACTIVE + RETIRING（及可选 NEXT）合并进同一 JWKS；有 RETIRING 时禁止只写 ACTIVE。
# 启用 `rss-access` profile 时 readyz 另注册 `rss_access_token_signing_rotation`（不依赖 RETIRING/NEXT；Active/Retiring/Next 卫生；见 closeout runbook）。
# 硬上限 900 秒；0 或 901+ 启动失败。
RSS_ACCESS_TOKEN_TTL_SECS=900
# compose 由 rss-access-jwks-init 经 export-vault-transit 导出：demo 仅 Active 时合并结果为单 key；
# 有 Retiring/Next 时必须合并进同一 JWKS（禁止只写 Active）。runtime 只读该路径。
RSS_ACCESS_TOKEN_JWKS_PATH=/run/rss-access-token/rss-access-jwks.json
RSS_ACCESS_TOKEN_JWKS_REFRESH_INTERVAL_SECS=60

# ── Service Token profile（HS256；仅 loopback Internal/operator）────────────────────────────────
# issuer/audience 必须与任一 access profile 不同；secret 为演示值，生产必须经密管替换。
RSS_SERVICE_TOKEN_ISSUER=https://rss-service.demo.local/
RSS_SERVICE_TOKEN_AUDIENCE=rss-internal
RSS_SERVICE_TOKEN_HS256_KID=rss-service-hs256
# RSS_SERVICE_TOKEN_HS256_SECRET_B64URL is bundle-only.

# ── 审计链 HMAC key（必填；base64url，解码后 ≥32B；缺失/弱 key fail-fast）──────────────────────────
# Audit-chain key is bundle-only.

# ── Vault（secret resolver + Transit `Signer` + settings ConfigValue encryption）───────────────────
# settings ConfigValue keyprovider 启动期会对 Transit key 做 encrypt+decrypt self-check（#1477）；
# vault `Signer` 在每次 login/refresh 真实请求 Transit 签 access JWT（#1252）。client 经 rustls
#（ring + webpki-roots）加密出网；生产须可达 vault + 有效证书链。ADDR 须 https（fail-fast 拒 http）。
# compose 演示栈使用 hashicorp/vault dev-tls 生成的 CA；生产改为真实 Vault 地址并删除/替换 CA path。
RSS_VAULT_ADDR=https://vault:8200
# Vault demo bootstrap tokens are mounted from deploy/demo-secrets, never inherited by server.
# 必填：严格、非空的 tenant/store → Vault KV v2 命名空间映射；仅接受 bindings 包装形态，
# 未知字段、重复 tenantId/storeId、非法路径或跨租户物理命名空间重叠均启动 fail-fast。
# 每个 binding 的命名空间必须预置保留键 `.rss-readiness`；独立 KV sampler 只读取该键，
# KV mount/ACL/canary 故障会把 `vault_secret_resolver_ready` 降为 unhealthy，而不影响 Transit 分类。
# 发布前离线校验渲染文件（不读取 provider env、不联网）：
# /usr/local/bin/rss vault-allowlist validate --file /run/rss-config/vault-allowlist.json
RSS_VAULT_TENANT_STORE_ALLOWLIST_JSON={"bindings":[{"tenantId":"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa","storeId":"vault","mount":"secret","kvPathPrefix":"tenants/a"}]}
# Serving Vault tokens are bundle-only.
# 可选：额外信任的 Vault HTTPS CA PEM。compose 会把 dev-tls CA 只读挂到此路径。
RSS_VAULT_CA_CERT_PEM_PATH=/run/rss-demo-vault/vault-ca.pem
# Transit 引擎 mount path（access JWT 签发 + settings ConfigValue encryption 复用）。
RSS_VAULT_TRANSIT_MOUNT=transit
# settings ConfigValue at-rest encryption 使用的 Transit key 名（缺失 / 非法值启动 fail-fast）。
RSS_SETTINGS_CONFIG_VALUE_KEY_NAME=settings-config
# 可选：keyprovider_ready 采样周期秒（默认 5，范围 1..=30）。
RSS_KEYPROVIDER_READINESS_SAMPLE_INTERVAL_SECS=5

# AuthGrant 与 refresh token 有效期秒（均可选，默认 30 天，最大 365 天）。
# AuthGrant 必须覆盖完整 refresh 生命周期；延长 refresh 时须同时把 AuthGrant 设为不小于该值。
# 例如 60 天 refresh 必须配 RSS_IDENTITY_AUTH_GRANT_TTL_SECS=5184000、RSS_REFRESH_TTL_SECS=5184000。
RSS_IDENTITY_AUTH_GRANT_TTL_SECS=2592000
RSS_REFRESH_TTL_SECS=2592000
# 本地 SHA-256 密码 blocklist；缺失、空集或格式错误均启动 fail-fast。
RSS_PASSWORD_BLOCKLIST_PATH=/run/rss-password-blocklist.sha256
