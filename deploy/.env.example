# RSS demo stack 演示环境变量（#1134）。供 deploy/docker-compose.yml 的 postgres + server 共享。
#
# ⚠️ 全部为**演示占位值**——生产须逐项替换（OIDC/Vault 指向真实服务、口令/密钥重新生成、PG 启 TLS）。
# server 对缺失的必填变量 fail-fast（不静默 noop）：任一缺失 → 进程启动即 Err 退出（含变量名）。
#
# 变量来源单源 = assemblies/runtime/src/lib.rs 的 build_* 读取点（fail-fast 站点）。

# ── PostgreSQL（postgres 容器初始化 + server 连接）───────────────────────────────────────────────
# postgres:16-alpine 初始化 owner（POSTGRES_*）：仅用于容器 init，不给 server 使用。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_demo_pw
POSTGRES_DB=rss
# init script 创建的 server login：非 superuser + NOBYPASSRLS；继承 rss_app 运行期 DML，无 DDL/CREATEROLE。
POSTGRES_APP_USER=rss_app_login
POSTGRES_APP_PASSWORD=rss_demo_pw
# runtime 内嵌迁移使用短生命周期 migrator 凭据；长期 server pool 不使用该角色。
RSS_PG_MIGRATOR_USERNAME=postgres
RSS_PG_MIGRATOR_PASSWORD=postgres_demo_pw
# server 连接用（RSS_PG_*）。HOST=compose 服务名 postgres；端口 5432；必须使用 NOBYPASSRLS app login。
RSS_PG_HOST=postgres
RSS_PG_PORT=5432
RSS_PG_DATABASE=rss
RSS_PG_USERNAME=rss_app_login
RSS_PG_PASSWORD=rss_demo_pw
# TLS 模式：演示 postgres 未启 TLS，显式降级 disable（默认 VerifyFull 会因无 TLS 连不上）。
# 生产删除本行（回退零信任默认 VerifyFull）或设 verify-full 并经 PgConfig::with_ssl_root_cert 配私有 CA。
RSS_PG_SSL_MODE=disable
# 可选：configs_ready DB 采样周期秒（默认 5，范围 1..=300）。
# RSS_PG_READINESS_SAMPLE_INTERVAL_SECS=5
# 可选：session_sweeper 过期会话清理周期毫秒（默认 300000，最小 1000；误配 warn + 默认）。
# RSS_SESSION_SWEEP_INTERVAL_MS=300000
# 可选安全豁免：临时允许启动时存在 legacy plaintext ConfigValue 行（默认 false）。
# 仅供 backfill 前短期评估；生产应保持未设置 / false，让 protection_scheme=0 阻断启动。
# RSS_SETTINGS_ALLOW_LEGACY_PLAINTEXT_CONFIG_VALUES=false

# ── Redis（distributed lock provider + readiness；缺失 / PING 失败启动 fail-fast）──────────────────
# compose 服务名 redis；演示栈显式选择 dev-container 明文策略，生产须 rediss:// + AUTH/TLS 且删除 opt-in。
RSS_REDIS_ALLOW_PLAINTEXT=dev-container
RSS_REDIS_URL=redis://redis:6379
# 可选：redis_ready PING 采样周期秒（默认 5，范围 1..=30）。
# RSS_REDIS_READINESS_SAMPLE_INTERVAL_SECS=5

# ── Event transport（durable-shared AMQP；生产须 amqps + 独立凭据/vhost）──────────────────────────
RSS_TOPOLOGY=durable-shared
# compose 服务名 rabbitmq；演示栈显式选择 dev-container 明文策略，生产须 amqps:// + 独立凭据/vhost 且删除 opt-in。
RSS_AMQP_ALLOW_PLAINTEXT=dev-container
RSS_AMQP_URL=amqp://guest:guest@rabbitmq:5672/%2f
# broker→consumer DLX authority HMAC key（base64url，解码后 ≥32B；生产经密管下发并轮换）。
RSS_TENANT_AUTHORITY_HMAC_KEY_B64URL=Q0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0M
# 可选：authority token TTL / clock skew 容忍（秒），默认 3600 / 60；clock skew 上限 300。
# RSS_TENANT_AUTHORITY_TTL_SECS=3600
# RSS_TENANT_AUTHORITY_CLOCK_SKEW_SECS=60
# DLX original_entry 加密用 Vault Transit key name（KeyProvider/Vault transit）。
RSS_DLX_PAYLOAD_KEY_NAME=rss-dlx-payload

# ── Listener bind 地址（4 个标准 listener，host:port；缺失 fail-fast）─────────────────────────────
# 0.0.0.0 = 容器内监听所有网卡（compose 端口映射才可达宿主）。
RSS_PRIMARY_LISTEN_ADDR=0.0.0.0:8080
RSS_INTERNAL_LISTEN_ADDR=0.0.0.0:8081
RSS_ADMIN_LISTEN_ADDR=0.0.0.0:8082
RSS_HEALTH_LISTEN_ADDR=0.0.0.0:8083

# ── 可观测性导出（#1253）─────────────────────────────────────────────────────────────────────────
# OTLP/gRPC trace 导出 collector 端点（按需开启）。未设 → 仅 fmt 日志、不导出 trace（演示默认留空）。
# https://… → TLS（生产）；http://… 仅 loopback host 明文 opt-in；非 loopback 明文 / 非 http(s) → 启动 fail-fast。
# Prometheus /metrics 无需此变量（PromExporter 随 run() 必装，scrape /health/v1/metrics）。
# RSS_OTEL_ENDPOINT=http://localhost:4317

# ── OIDC（JWT 验签 IdP；issuer/audience/trusted_kinds 必填 + ES256/HS256 至少一把）────────────────
RSS_OIDC_ISSUER=https://oidc.demo.local/
RSS_OIDC_AUDIENCE=rss
# 本 IdP 可 assert 的 principal kind 白名单（逗号分隔，≥1；空则所有 JWT 401）。
RSS_OIDC_TRUSTED_KINDS=user,admin,device
# service-token 路径 HS256 密钥（base64url）。演示随机值——生产重生成并经密管下发。
RSS_OIDC_HS256_SECRET_B64URL=0K-opV-ConWLqaqp2202nIIBXpt0Wd63aRgOPN8EFLw
# JWT 路径 ES256 公钥（base64url SEC1 未压缩点，逗号分隔可多把）。演示用 HS256，故留空。
# RSS_OIDC_ES256_SEC1_B64URL=

# ── 审计链 HMAC key（必填；base64url，解码后 ≥32B；缺失/弱 key fail-fast）──────────────────────────
# 演示随机 32B key——生产经密管下发、按租户/环境轮换。
RSS_AUDIT_CHAIN_KEY_B64URL=mIFwQhSZheUUi4_-Sf9rpCq_Wh8Ky1c9y99XvC1qHAk

# ── Vault（secret resolver + Transit `Signer` + settings ConfigValue encryption）───────────────────
# settings ConfigValue keyprovider 启动期会对 Transit key 做 encrypt+decrypt self-check（#1477）；
# vault `Signer` 在每次 login/refresh 真实请求 Transit 签 access JWT（#1252）。client 经 rustls
#（ring + webpki-roots）加密出网；生产须可达 vault + 有效证书链。ADDR 须 https（fail-fast 拒 http）。
# compose 演示栈使用 hashicorp/vault dev-tls 生成的 CA；生产改为真实 Vault 地址并删除/替换 CA path。
RSS_VAULT_ADDR=https://vault:8200
RSS_VAULT_TOKEN=demo-token
# 可选：额外信任的 Vault HTTPS CA PEM。compose 会把 dev-tls CA 只读挂到此路径。
RSS_VAULT_CA_CERT_PEM_PATH=/run/rss-demo-vault/vault-ca.pem
# Transit 引擎 mount path（access JWT 签发 + settings ConfigValue encryption 复用）。
RSS_VAULT_TRANSIT_MOUNT=transit
# settings ConfigValue at-rest encryption 使用的 Transit key 名（缺失 / 非法值启动 fail-fast）。
RSS_SETTINGS_CONFIG_VALUE_KEY_NAME=settings-config
# 可选：keyprovider_ready 采样周期秒（默认 5，范围 1..=30）。
RSS_KEYPROVIDER_READINESS_SAMPLE_INTERVAL_SECS=5

# ── access JWT 签发（#1252；vault Transit ES256 签，iss/aud 须与上方 OIDC 验签侧一致）──────────────────
RSS_JWT_ISSUER=https://oidc.demo.local/
RSS_JWT_AUDIENCE=rss
# vault Transit sign key 名 = JOSE kid（验签侧据此选 RSS_OIDC_ES256_SEC1_B64URL 公钥，须一致接线）。
RSS_JWT_ES256_KEY_ID=rss-jwt-es256
# access JWT 有效期秒（> 0）。
RSS_JWT_ACCESS_TTL_SECS=900
# refresh token 有效期秒（可选，默认 30 天）。
RSS_REFRESH_TTL_SECS=2592000
