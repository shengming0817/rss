# Demo-only bootstrap fixture. Production L2 DR credentials must be projected as password files;
# plaintext password environment variables are rejected by the provisioner and runtime.
POSTGRES_PASSWORD=postgres_demo_pw
RSS_PG_PASSWORD_FILE=/run/rss-demo-secrets/pg-writer-password
RSS_PG_READ_PASSWORD_FILE=/run/rss-demo-secrets/pg-reader-password
RSS_PG_PROJECTION_READER_PASSWORD_FILE=/run/rss-demo-secrets/pg-projection-reader-password
RSS_PG_PROJECTION_OPERATOR_PASSWORD_FILE=/run/rss-demo-secrets/pg-projection-operator-password
RSS_PG_SAGA_OPERATOR_PASSWORD_FILE=/run/rss-demo-secrets/pg-saga-operator-password
RSS_PG_L2_DR_RECOVERY_AUDITOR_PASSWORD_FILE=/run/rss-demo-secrets/pg-l2-dr-recovery-auditor-password
RSS_PG_L2_DR_RECOVERY_EXECUTOR_PASSWORD_FILE=/run/rss-demo-secrets/pg-l2-dr-recovery-executor-password
RSS_PG_DLX_ARCHIVER_PASSWORD_FILE=/run/rss-demo-secrets/pg-dlx-archiver-password
RSS_PG_DLX_VERIFIER_PASSWORD_FILE=/run/rss-demo-secrets/pg-dlx-verifier-password
RSS_PG_DLX_PURGER_PASSWORD_FILE=/run/rss-demo-secrets/pg-dlx-purger-password
