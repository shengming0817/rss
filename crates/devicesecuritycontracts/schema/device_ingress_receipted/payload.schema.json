{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuthorizationReceiptId": {
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "title": "AuthorizationReceiptId",
      "type": "string",
      "x-redaction": "internal"
    },
    "IdentityDeviceIngressCommittedPayload": {
      "additionalProperties": false,
      "properties": {
        "authorizationReceiptId": {
          "$ref": "#/definitions/AuthorizationReceiptId",
          "x-redaction": "internal"
        },
        "committedAt": {
          "format": "int64",
          "type": "integer"
        },
        "desiredGeneration": {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "deviceId": {
          "format": "uuid",
          "type": "string"
        },
        "ingressEnvelopeId": {
          "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "enum": [
            "committed"
          ],
          "type": "string"
        },
        "reason": {
          "enum": [
            "None"
          ],
          "type": "string"
        }
      },
      "required": [
        "ingressEnvelopeId",
        "deviceId",
        "authorizationReceiptId",
        "desiredGeneration",
        "outcome",
        "reason",
        "committedAt"
      ],
      "title": "IdentityDeviceIngressCommittedPayload",
      "type": "object"
    },
    "IdentityDeviceIngressDuplicatePayload": {
      "additionalProperties": false,
      "properties": {
        "authorizationReceiptId": {
          "$ref": "#/definitions/AuthorizationReceiptId",
          "x-redaction": "internal"
        },
        "committedAt": {
          "format": "int64",
          "type": "integer"
        },
        "desiredGeneration": {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "deviceId": {
          "format": "uuid",
          "type": "string"
        },
        "ingressEnvelopeId": {
          "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "enum": [
            "duplicate"
          ],
          "type": "string"
        },
        "reason": {
          "enum": [
            "AlreadyCommitted"
          ],
          "type": "string"
        }
      },
      "required": [
        "ingressEnvelopeId",
        "deviceId",
        "authorizationReceiptId",
        "desiredGeneration",
        "outcome",
        "reason",
        "committedAt"
      ],
      "title": "IdentityDeviceIngressDuplicatePayload",
      "type": "object"
    },
    "IdentityDeviceIngressRejectedPayload": {
      "additionalProperties": false,
      "properties": {
        "committedAt": {
          "format": "int64",
          "type": "integer"
        },
        "deviceId": {
          "format": "uuid",
          "type": "string"
        },
        "ingressEnvelopeId": {
          "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "enum": [
            "rejected"
          ],
          "type": "string"
        },
        "reason": {
          "enum": [
            "NotAccepted",
            "SchemaRejected",
            "ProtocolViolation"
          ],
          "type": "string"
        }
      },
      "required": [
        "ingressEnvelopeId",
        "deviceId",
        "outcome",
        "reason",
        "committedAt"
      ],
      "title": "IdentityDeviceIngressRejectedPayload",
      "type": "object"
    },
    "IdentityDeviceIngressStalePayload": {
      "additionalProperties": false,
      "properties": {
        "authorizationReceiptId": {
          "$ref": "#/definitions/AuthorizationReceiptId",
          "x-redaction": "internal"
        },
        "committedAt": {
          "format": "int64",
          "type": "integer"
        },
        "desiredGeneration": {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "deviceId": {
          "format": "uuid",
          "type": "string"
        },
        "ingressEnvelopeId": {
          "description": "Correlation to the receipted inbound envelope, not this receipt event's identity.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "enum": [
            "stale"
          ],
          "type": "string"
        },
        "reason": {
          "enum": [
            "GenerationStale",
            "FenceEpochStale",
            "DeviceSequenceStale"
          ],
          "type": "string"
        }
      },
      "required": [
        "ingressEnvelopeId",
        "deviceId",
        "authorizationReceiptId",
        "desiredGeneration",
        "outcome",
        "reason",
        "committedAt"
      ],
      "title": "IdentityDeviceIngressStalePayload",
      "type": "object"
    }
  },
  "description": "Draft OutboxFact application-receipt payload proposal. Its own stable event ID is carried only by the envelope.",
  "oneOf": [
    {
      "$ref": "#/definitions/IdentityDeviceIngressCommittedPayload"
    },
    {
      "$ref": "#/definitions/IdentityDeviceIngressDuplicatePayload"
    },
    {
      "$ref": "#/definitions/IdentityDeviceIngressStalePayload"
    },
    {
      "$ref": "#/definitions/IdentityDeviceIngressRejectedPayload"
    }
  ],
  "title": "IdentityDeviceIngressReceiptedPayload"
}
