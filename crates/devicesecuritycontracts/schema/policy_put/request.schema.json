{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityDeviceCertificatePolicyPutRequest",
  "description": "Tenant comes from authenticated scope and device identity comes from the HTTP path.",
  "type": "object",
  "required": [
    "idempotencyKey",
    "expectedGeneration",
    "policy"
  ],
  "properties": {
    "idempotencyKey": {
      "description": "UUID scoped to the authenticated tenant and path device. Reuse is valid only for the same canonical request.",
      "type": "string",
      "format": "uuid",
      "x-redaction": "internal"
    },
    "expectedGeneration": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "policy": {
      "title": "IdentityDeviceCertificatePolicyPutPolicy",
      "type": "object",
      "required": [
        "validitySeconds",
        "renewBeforeSeconds",
        "keyUsages"
      ],
      "properties": {
        "validitySeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 300,
          "maximum": 31536000
        },
        "renewBeforeSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 60,
          "maximum": 31535999
        },
        "keyUsages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "clientAuth",
              "serverAuth"
            ]
          },
          "x-redaction": "internal"
        },
        "sans": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "x-pii": "generic",
          "x-redaction": "drop"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
