{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityDeviceCertificatePolicyPutConflictResponse",
  "description": "A generation mismatch or idempotency-key fingerprint mismatch rejects the write.",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "title": "IdentityDeviceCertificatePolicyPutConflictError",
      "oneOf": [
        {
          "type": "object",
          "required": ["code", "message", "retryable", "details", "requestId"],
          "properties": {
            "code": { "type": "string", "enum": ["ERR_CORE_VERSION_CONFLICT"] },
            "message": { "type": "string", "enum": ["version conflict"] },
            "retryable": { "type": "boolean", "const": false },
            "details": { "type": "array", "maxItems": 0, "items": { "type": "object", "additionalProperties": { "type": "string" } } },
            "requestId": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "message", "retryable", "details", "requestId"],
          "properties": {
            "code": { "type": "string", "enum": ["ERR_CORE_CONFLICT"] },
            "message": { "type": "string", "enum": ["conflict"] },
            "retryable": { "type": "boolean", "const": false },
            "details": { "type": "array", "maxItems": 0, "items": { "type": "object", "additionalProperties": { "type": "string" } } },
            "requestId": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
